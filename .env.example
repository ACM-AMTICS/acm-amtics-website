# =====================================================================
# ACM AMTICS Website - Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# DO NOT commit real secrets or production credentials to source control.
# =====================================================================

# ASP.NET Core Runtime Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# MongoDB Connection String (Atlas URI or local standalone)
# Example Atlas format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# MongoDB Database Name
MONGODB_DB_NAME=acm_amtics_admin_db

# Initial Admin Seeding (Used only if no admin exists in the database)
ADMIN_EMAIL=admin@amtics.acm.org
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_FULLNAME="ACM Administrator"
