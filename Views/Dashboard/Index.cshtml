@model acm_amtics_website.Models.DashboardStatsDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    var formattedDate = DateTime.Now.ToString("ddd, dd MMM yyyy");
}

<!-- Page Header Row -->
<div class="page-header-row">
    <div class="header-titles">
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back, Admin! Here's an overview of ACM Amtics.</p>
    </div>
    <div class="header-date">
        <div class="date-indicator-badge">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>@formattedDate</span>
        </div>
    </div>
</div>

<!-- 4 Stat Cards Grid -->
<div class="stat-cards-grid">
    <!-- Card 1: Members -->
    <div class="stat-card">
        <div class="stat-card-left">
            <div class="stat-icon-wrapper">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-3.512M9 20H4v-2a3 3 0 015-3.512M12 11a4 4 0 100-8 4 4 0 000 8zm0 2a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <div class="stat-label">Members</div>
            <div class="stat-value" id="statMembersCount">@(Model?.Members?.Count ?? 124)</div>
            <div class="stat-change-indicator">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
                <span>@(Model?.Members?.ChangePercentage ?? "+12%")</span>
                <span class="stat-change-text">from last month</span>
            </div>
        </div>
        <!-- Sparkline Curve SVG -->
        <svg class="stat-card-sparkline" viewBox="0 0 100 50" preserveAspectRatio="none">
            <defs>
                <linearGradient id="gradPurple1" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0.0"/>
                </linearGradient>
            </defs>
            <path d="M0,40 Q25,35 45,20 T90,10 L100,8 L100,50 L0,50 Z" fill="url(#gradPurple1)"/>
            <path d="M0,40 Q25,35 45,20 T90,10 L100,8" fill="none" stroke="#8B5CF6" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
    </div>

    <!-- Card 2: Events -->
    <div class="stat-card">
        <div class="stat-card-left">
            <div class="stat-icon-wrapper">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </div>
            <div class="stat-label">Events</div>
            <div class="stat-value">@(Model?.Events?.Count ?? 18)</div>
            <div class="stat-change-indicator">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
                <span>@(Model?.Events?.ChangePercentage ?? "+20%")</span>
                <span class="stat-change-text">from last month</span>
            </div>
        </div>
        <!-- Sparkline Curve SVG -->
        <svg class="stat-card-sparkline" viewBox="0 0 100 50" preserveAspectRatio="none">
            <defs>
                <linearGradient id="gradPurple2" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0.0"/>
                </linearGradient>
            </defs>
            <path d="M0,42 Q30,25 55,30 T95,12 L100,10 L100,50 L0,50 Z" fill="url(#gradPurple2)"/>
            <path d="M0,42 Q30,25 55,30 T95,12 L100,10" fill="none" stroke="#8B5CF6" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
    </div>

    <!-- Card 3: Attendees -->
    <div class="stat-card">
        <div class="stat-card-left">
            <div class="stat-icon-wrapper">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <div class="stat-label">Attendees</div>
            <div class="stat-value">@(Model?.Attendees?.Count ?? 860)</div>
            <div class="stat-change-indicator">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
                <span>@(Model?.Attendees?.ChangePercentage ?? "+16%")</span>
                <span class="stat-change-text">from last month</span>
            </div>
        </div>
        <!-- Sparkline Curve SVG -->
        <svg class="stat-card-sparkline" viewBox="0 0 100 50" preserveAspectRatio="none">
            <defs>
                <linearGradient id="gradPurple3" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0.0"/>
                </linearGradient>
            </defs>
            <path d="M0,38 Q20,38 45,28 T90,8 L100,6 L100,50 L0,50 Z" fill="url(#gradPurple3)"/>
            <path d="M0,38 Q20,38 45,28 T90,8 L100,6" fill="none" stroke="#8B5CF6" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
    </div>

    <!-- Card 4: Projects -->
    <div class="stat-card">
        <div class="stat-card-left">
            <div class="stat-icon-wrapper">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
            </div>
            <div class="stat-label">Projects</div>
            <div class="stat-value">@(Model?.Projects?.Count ?? 12)</div>
            <div class="stat-change-indicator">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
                <span>@(Model?.Projects?.ChangePercentage ?? "+33%")</span>
                <span class="stat-change-text">from last month</span>
            </div>
        </div>
        <!-- Sparkline Curve SVG -->
        <svg class="stat-card-sparkline" viewBox="0 0 100 50" preserveAspectRatio="none">
            <defs>
                <linearGradient id="gradPurple4" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0.0"/>
                </linearGradient>
            </defs>
            <path d="M0,45 Q35,40 50,22 T95,10 L100,7 L100,50 L0,50 Z" fill="url(#gradPurple4)"/>
            <path d="M0,45 Q35,40 50,22 T95,10 L100,7" fill="none" stroke="#8B5CF6" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
    </div>
</div>

<!-- All Members Section Card -->
<div class="card-section">
    <div class="card-section-header">
        <div class="header-left">
            <h2 class="section-title">All Members</h2>
            <p class="section-subtitle">Manage and view all registered members of ACM Amtics.</p>
        </div>
        <div class="section-actions">
            <!-- Search Input -->
            <div class="search-wrapper">
                <svg class="search-icon" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" id="memberSearchInput" class="search-input" placeholder="Search members..." autocomplete="off" />
            </div>

            <!-- Add Member Button: ONLY rendered on Dashboard -->
            @if (ViewBag.ShowAddMemberButton == true)
            {
                <button type="button" class="btn-primary" id="openAddMemberBtn">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>Add Member</span>
                </button>
            }
        </div>
    </div>

    <!-- Members Table -->
    <div class="table-responsive">
        <table class="members-table">
            <thead>
                <tr>
                    <th class="col-num">#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Join Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="membersTableBody">
                <!-- Dynamically populated via AJAX in admin-members.js -->
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    <div class="card-section-footer">
        <div class="pagination-info" id="paginationInfo">
            Showing 1 to 8 of 124 members
        </div>
        <div class="pagination-controls" id="paginationControls">
            <!-- Dynamically populated via AJAX in admin-members.js -->
        </div>
    </div>
</div>

<!-- Add Member Modal (Rendered strictly on Dashboard) -->
@if (ViewBag.ShowAddMemberButton == true)
{
    <div class="modal-backdrop" id="addMemberModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="modal-container">
            <!-- Close Button -->
            <button type="button" class="modal-close-btn" id="closeModalBtn" aria-label="Close Modal">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <!-- Modal Header -->
            <div class="modal-header">
                <h3 class="modal-title" id="modalTitle">Add Member</h3>
                <p class="modal-subtitle">Add a new member to ACM Amtics.</p>
            </div>

            <!-- Modal Form -->
            <form id="addMemberForm" novalidate>
                <!-- Name Field -->
                <div class="modal-form-group">
                    <label class="modal-form-label" for="memberName">Name</label>
                    <div class="input-with-icon-wrapper">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </span>
                        <input type="text" id="memberName" class="modal-input" placeholder="Enter full name" required />
                    </div>
                    <div class="form-error-msg" id="memberNameError"></div>
                </div>

                <!-- Email Address Field -->
                <div class="modal-form-group">
                    <label class="modal-form-label" for="memberEmail">Email Address</label>
                    <div class="input-with-icon-wrapper">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </span>
                        <input type="email" id="memberEmail" class="modal-input" placeholder="Enter email address" required />
                    </div>
                    <div class="form-error-msg" id="memberEmailError"></div>
                </div>

                <!-- Phone Number Field with Country Code -->
                <div class="modal-form-group">
                    <label class="modal-form-label" for="memberPhone">Phone Number</label>
                    <div class="phone-input-combined">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                        </span>
                        <input type="tel" id="memberPhone" class="phone-input-field" placeholder="Enter phone number" required />
                        <select id="memberCountryCode" class="country-code-select" aria-label="Country Code">
                            <option value="+91" selected>+91</option>
                            <option value="+1">+1</option>
                            <option value="+44">+44</option>
                            <option value="+61">+61</option>
                        </select>
                    </div>
                    <div class="form-error-msg" id="memberPhoneError"></div>
                </div>

                <!-- Enrollment Number Field -->
                <div class="modal-form-group">
                    <label class="modal-form-label" for="memberEnrollment">Enrollment Number</label>
                    <div class="input-with-icon-wrapper">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
                            </svg>
                        </span>
                        <input type="text" id="memberEnrollment" class="modal-input" placeholder="Enter enrollment number" required />
                    </div>
                    <div class="form-error-msg" id="memberEnrollmentError"></div>
                </div>

                <!-- Role Field -->
                <div class="modal-form-group">
                    <label class="modal-form-label" for="memberRole">Role</label>
                    <div class="input-with-icon-wrapper">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-3.512M9 20H4v-2a3 3 0 015-3.512M12 11a4 4 0 100-8 4 4 0 000 8zm0 2a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </span>
                        <select id="memberRole" class="modal-select" required>
                            <option value="Member" selected>Member</option>
                            <option value="Coordinator">Coordinator</option>
                            <option value="Event Head">Event Head</option>
                            <option value="Technical Head">Technical Head</option>
                            <option value="Vice President">Vice President</option>
                            <option value="President">President</option>
                        </select>
                        <span class="select-right-chevron">
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </div>
                    <div class="form-error-msg" id="memberRoleError"></div>
                </div>

                <!-- Conditional Dynamic Field: Assign Event (displayed when Role != "Member" or Role == "Coordinator") -->
                <div class="dynamic-field-container" id="dynamicEventGroup">
                    <label class="modal-form-label" for="assignEventSelect">Assign Event</label>
                    <div class="input-with-icon-wrapper">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </span>
                        <select id="assignEventSelect" class="modal-select">
                            <option value="">Select an Event</option>
                            <!-- Dynamically loaded via /api/events -->
                        </select>
                        <span class="select-right-chevron">
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </div>
                </div>

                <!-- Footer Buttons -->
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" id="cancelModalBtn">Cancel</button>
                    <button type="submit" class="modal-btn-submit" id="submitAddMemberBtn">Add Member</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        window.adminViewContext = '@(ViewBag.ViewContext ?? "Dashboard")';
    </script>
    <script src="~/js/admin-members.js" asp-append-version="true"></script>
}
