@{
    Layout = "_Layout";
    ViewData["Title"] = "Member Profile - Ayesha Khan";
}

<!-- Google Fonts: Caveat for Doodles -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="member-public-page">
    <!-- Ambient Background Lighting & Doodles -->
    <div class="profile-ambient-bg" style="top:50px;" aria-hidden="true">
        <div class="profile-glow-orb"></div>
        <div class="profile-dot-grid"></div>
        <div class="profile-doodle-quote" style="top:40px; right:220px;">
            Ideas<br />
            Community<br />
            Technology<br />
            Impact
            <svg class="profile-doodle-arrow" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round">
                <path d="M 20 20 Q 80 40 40 85 M 40 85 L 55 70 M 40 85 L 30 65" />
            </svg>
        </div>
    </div>

    <!-- Campus Building Floating Image in Header Background -->
    <div style="position:absolute; top:20px; right:20px; z-index:0; opacity:0.85; max-width:320px; border-radius:16px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.06); display:none;" class="desktop-campus-float">
        <img src="/images/amtics-building.jpg" alt="AMTICS Campus" style="width:100%; height:auto; display:block;" />
    </div>

    <!-- Breadcrumb Row -->
    <nav class="profile-breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">
            <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span>Home</span>
        </a>
        <span class="breadcrumb-sep">&rsaquo;</span>
        <a href="/Members">Team</a>
        <span class="breadcrumb-sep">&rsaquo;</span>
        <span class="breadcrumb-current">Member Profile</span>
    </nav>

    <!-- Page Title Header -->
    <div class="profile-header-titles" style="margin-bottom:1.75rem;">
        <h1 class="profile-main-title">
            Member <span class="profile-title-gradient">Profile</span>
        </h1>
        <p class="profile-main-subtitle">
            Explore achievements, event history, and submitted projects of ACM AMTICS community members.
        </p>
    </div>

    <!-- Member Profile Hero Card (Matching Image 3) -->
    <div class="profile-hero-card" style="margin-bottom:2rem;">
        <div class="profile-hero-left">
            <div class="profile-avatar-container" style="width:115px; height:115px;">
                <img src="/images/avatars/ayesha-khan.jpg" alt="Ayesha Khan" class="profile-avatar-img user-profile-avatar" onerror="this.src='/images/avatars/avatar-1.jpg'" />
            </div>

            <div class="profile-info-group">
                <div class="profile-name-row">
                    <h2 class="profile-user-name user-profile-name">Ayesha Khan</h2>
                    <span class="profile-member-badge">Member</span>
                </div>
                <div class="profile-user-headline user-profile-dept">
                    3rd Year &bull; Computer Science & Engineering
                </div>
                <div class="profile-meta-row">
                    <div class="profile-meta-item">
                        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <span class="user-profile-email">ayesha.k@amtics.ac.in</span>
                    </div>
                    <div class="profile-meta-item">
                        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span class="user-profile-college">AMTICS, Gandhinagar</span>
                    </div>
                </div>
                <p class="profile-user-bio user-profile-bio" style="max-width:650px;">
                    Passionate about design, technology and community building. Excited to learn, collaborate and create meaningful impact with ACM AMTICS.
                </p>
            </div>
        </div>

        <div class="profile-hero-right">
            <!-- Social Circle Icons Row (Image 3) -->
            <div class="member-public-socials">
                <a href="https://github.com" target="_blank" class="social-circle-btn" title="GitHub Profile">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
                <a href="https://linkedin.com" target="_blank" class="social-circle-btn" title="LinkedIn Profile">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </a>
                <a href="https://twitter.com" target="_blank" class="social-circle-btn" title="Twitter / X">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a href="https://acmamtics.org" target="_blank" class="social-circle-btn" title="Portfolio / Website">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                </a>
            </div>

            <!-- Quote Card -->
            <div class="profile-quote-card">
                <span class="profile-quote-icon">&ldquo;</span>
                <span class="profile-quote-text">
                    <span class="user-profile-quote">Ideas grow when shared.</span>
                    <span class="profile-quote-rocket">&nbsp;&nbsp;&#128640;</span>
                </span>
            </div>

            <!-- Profile Actions -->
            <div class="profile-actions-row">
                <a href="/Profile" class="btn-edit-profile" title="Manage Profile Settings">
                    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                    <span>Manage My Profile</span>
                </a>
                <button type="button" class="btn-primary-purple" onclick="openEventTicketModal()" style="font-size:0.875rem; padding:0.6rem 1.15rem;">
                    <span>View Event Pass</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 4 Key Stat Metric Cards Row -->
    <div class="profile-stats-grid" style="margin-bottom:2rem;">
        <div class="profile-stat-card">
            <div class="profile-stat-left">
                <div class="profile-stat-icon-wrap">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    </svg>
                </div>
                <div class="profile-stat-data">
                    <span class="profile-stat-number" id="statBadgesNum">6</span>
                    <span class="profile-stat-label">Badges Earned</span>
                </div>
            </div>
            <div class="profile-stat-arrow-btn">&rarr;</div>
        </div>

        <div class="profile-stat-card">
            <div class="profile-stat-left">
                <div class="profile-stat-icon-wrap">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div class="profile-stat-data">
                    <span class="profile-stat-number" id="statEventsNum">12</span>
                    <span class="profile-stat-label">Events Attended</span>
                </div>
            </div>
            <div class="profile-stat-arrow-btn">&rarr;</div>
        </div>

        <div class="profile-stat-card">
            <div class="profile-stat-left">
                <div class="profile-stat-icon-wrap">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                </div>
                <div class="profile-stat-data">
                    <span class="profile-stat-number" id="statProjectsNum">4</span>
                    <span class="profile-stat-label">Projects Submitted</span>
                </div>
            </div>
            <div class="profile-stat-arrow-btn">&rarr;</div>
        </div>

        <div class="profile-stat-card">
            <div class="profile-stat-left">
                <div class="profile-stat-icon-wrap">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-3.512M9 20H4v-2a3 3 0 015-3.512M12 11a4 4 0 100-8 4 4 0 000 8zm0 2a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                <div class="profile-stat-data">
                    <span class="profile-stat-number" id="statRolesNum">2</span>
                    <span class="profile-stat-label">Coordinator Roles</span>
                </div>
            </div>
            <div class="profile-stat-arrow-btn">&rarr;</div>
        </div>
    </div>

    <!-- Main Public Profile Layout Grid -->
    <div style="display:grid; grid-template-columns: 360px 1fr; gap:1.75rem; align-items:start;">
        <!-- Left Column: About Me & Skills -->
        <div style="display:flex; flex-direction:column; gap:1.5rem;">
            <!-- About Me Card -->
            <div class="profile-section-card">
                <div class="profile-card-header" style="margin-bottom:1rem;">
                    <div class="profile-card-header-left">
                        <div class="profile-card-header-icon">
                            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        <h3 class="profile-card-title">About Me</h3>
                    </div>
                </div>

                <p class="profile-user-bio user-profile-bio" style="font-size:0.875rem; line-height:1.6; color:#4B5563;">
                    Passionate about design, technology and community building. Excited to learn, collaborate and create meaningful impact with ACM AMTICS.
                </p>

                <div style="margin-top:1.25rem;">
                    <div style="font-size:0.75rem; font-weight:700; text-transform:uppercase; color:#6B7280; letter-spacing:0.04em;">Skills & Interests</div>
                    <div class="skills-pill-wrap">
                        <span class="skill-pill">#UI/UX Design</span>
                        <span class="skill-pill">#Frontend</span>
                        <span class="skill-pill">#React.js</span>
                        <span class="skill-pill">#Figma</span>
                        <span class="skill-pill">#Python</span>
                        <span class="skill-pill">#Community</span>
                    </div>
                </div>

                <div style="margin-top:1.5rem; border-top:1px solid #F1F4F9; padding-top:1.25rem;">
                    <div class="quick-info-list" style="margin-bottom:0;">
                        <div class="quick-info-item">
                            <div class="quick-info-content">
                                <span class="quick-info-label">Member Since</span>
                                <span class="quick-info-val">Aug 2024</span>
                            </div>
                        </div>
                        <div class="quick-info-item">
                            <div class="quick-info-content">
                                <span class="quick-info-label">Academic Year</span>
                                <span class="quick-info-val user-profile-year">3rd Year (2025 &ndash; 2026)</span>
                            </div>
                        </div>
                        <div class="quick-info-item">
                            <div class="quick-info-content">
                                <span class="quick-info-label">Department</span>
                                <span class="quick-info-val">Computer Science & Engineering</span>
                            </div>
                        </div>
                        <div class="quick-info-item">
                            <div class="quick-info-content">
                                <span class="quick-info-label">College</span>
                                <span class="quick-info-val user-profile-college">AMTICS, Gandhinagar</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Badges & Showcase -->
        <div style="display:flex; flex-direction:column; gap:1.75rem;">
            <!-- Badges Showcase Card -->
            <div class="profile-section-card">
                <div class="profile-card-header">
                    <div class="profile-card-header-left">
                        <div class="profile-card-header-icon">
                            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                            </svg>
                        </div>
                        <div class="profile-card-titles">
                            <h3 class="profile-card-title">Earned Badges & Recognitions</h3>
                            <p class="profile-card-subtitle">Official accomplishments earned through chapter participation.</p>
                        </div>
                    </div>
                </div>

                <div class="profile-badges-row" id="profileBadgesContainer">
                    <!-- Populated dynamically by profile.js -->
                </div>
            </div>

            <!-- Sub Grid: Recent Projects & Events -->
            <div class="profile-sub-cards-grid">
                <!-- Recent Projects -->
                <div class="profile-section-card">
                    <div class="profile-card-header">
                        <div class="profile-card-header-left">
                            <div class="profile-card-header-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                                </svg>
                            </div>
                            <div class="profile-card-titles">
                                <h3 class="profile-card-title">Submitted Projects</h3>
                                <p class="profile-card-subtitle">Recent projects built by this member.</p>
                            </div>
                        </div>
                    </div>
                    <div class="profile-items-list" id="submittedProjectsList">
                        <!-- Populated by profile.js -->
                    </div>
                </div>

                <!-- Recent Events -->
                <div class="profile-section-card">
                    <div class="profile-card-header">
                        <div class="profile-card-header-left">
                            <div class="profile-card-header-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div class="profile-card-titles">
                                <h3 class="profile-card-title">Attended Events</h3>
                                <p class="profile-card-subtitle">Verified attendance history.</p>
                            </div>
                        </div>
                    </div>
                    <div class="profile-items-list" id="recentEventsList">
                        <!-- Populated by profile.js -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Re-use Ticket Modal for Event Pass Preview -->
<div class="modal-overlay-custom" id="eventTicketModal" role="dialog" aria-modal="true" aria-labelledby="ticketTitle">
    <div class="ticket-modal-card">
        <div class="ticket-modal-header">
            <div class="ticket-modal-header-left">
                <div class="ticket-modal-icon-badge">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                    </svg>
                </div>
                <div>
                    <h3 class="ticket-modal-title" id="ticketTitle">My Event Ticket</h3>
                    <p class="ticket-modal-subtitle">Official verified member event check-in pass.</p>
                </div>
            </div>
            <button type="button" class="ticket-modal-close-btn" onclick="closeEventTicketModal()" aria-label="Close modal">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="digital-ticket-pass" id="printableTicketPass">
            <div class="ticket-top-section">
                <div class="ticket-logo-row">
                    <img src="/images/acm-logo.svg" alt="ACM AMTICS" class="ticket-logo-img" />
                    <div class="ticket-brand-text">
                        <div class="ticket-brand-title">ACM AMTICS</div>
                        <div class="ticket-brand-subtitle">Student Chapter</div>
                    </div>
                </div>
                <div class="ticket-role-pill">MEMBER</div>
                <div class="ticket-holder-name" id="ticketHolderName">Ayesha Khan</div>
                <div class="ticket-holder-dept" id="ticketHolderDept">3rd Year &bull; Computer Science & Engineering</div>

                <div class="ticket-qr-container">
                    <svg class="ticket-qr-code-svg" viewBox="0 0 200 200" fill="none">
