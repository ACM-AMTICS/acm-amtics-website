                        <rect x="144" y="34" width="22" height="22" rx="2" fill="#7C3AED" />
                        <rect x="20" y="130" width="50" height="50" rx="4" fill="#1E1B4B" />
                        <rect x="28" y="138" width="34" height="34" rx="2" fill="white" />
                        <rect x="34" y="144" width="22" height="22" rx="2" fill="#7C3AED" />
                        <rect x="80" y="24" width="10" height="10" fill="#1E1B4B" />
                        <rect x="100" y="24" width="10" height="10" fill="#1E1B4B" />
                        <rect x="80" y="44" width="10" height="10" fill="#7C3AED" />
                        <rect x="94" y="54" width="12" height="12" fill="#1E1B4B" />
                        <rect x="110" y="40" width="10" height="10" fill="#7C3AED" />
                        <rect x="24" y="80" width="10" height="10" fill="#1E1B4B" />
                        <rect x="80" y="80" width="14" height="14" fill="#1E1B4B" />
                        <rect x="104" y="80" width="12" height="12" fill="#7C3AED" />
                        <rect x="130" y="84" width="12" height="12" fill="#1E1B4B" />
                        <rect x="154" y="80" width="10" height="10" fill="#1E1B4B" />
                        <rect x="80" y="130" width="10" height="10" fill="#1E1B4B" />
                        <rect x="120" y="130" width="10" height="12" fill="#1E1B4B" />
                        <rect x="160" y="130" width="12" height="10" fill="#7C3AED" />
                    </svg>
                </div>
                <div class="ticket-code-id" id="ticketCodeDisplay">#AMTICS-2024-087</div>
            </div>

            <div class="ticket-divider-row">
                <div class="ticket-notch-left"></div>
                <div class="ticket-dashed-line"></div>
                <div class="ticket-notch-right"></div>
            </div>

            <div class="ticket-bottom-section">
                <div class="ticket-metric-box">
                    <div class="ticket-metric-icon">&infin;</div>
                    <div class="ticket-metric-label">Valid For All Events</div>
                    <div class="ticket-metric-sub">Use this ticket for every ACM AMTICS event.</div>
                </div>
                <div class="ticket-metric-box">
                    <div class="ticket-metric-icon">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div class="ticket-metric-label">Member Since</div>
                    <div class="ticket-metric-sub" id="ticketMemberSince">Aug 2024</div>
                </div>
                <div class="ticket-metric-box">
                    <div class="ticket-metric-icon">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    <div class="ticket-metric-label">Authorized Member</div>
                    <div class="ticket-metric-sub">Show this QR code at the registration desk.</div>
                </div>
            </div>
        </div>

        <div class="ticket-alert-callout">
            <div class="ticket-alert-icon">&#9432;</div>
            <div class="ticket-alert-text">
                <strong>Keep this ticket handy</strong><br />
                You can always find this ticket in your profile and use it for all future events.
            </div>
        </div>

        <div class="ticket-modal-actions">
            <button type="button" class="btn-ticket-download" onclick="printEventTicket()">Print Ticket</button>
            <button type="button" class="btn-ticket-close" onclick="closeEventTicketModal()">Close</button>
        </div>
    </div>
</div>

<!-- Badge Detail Modal -->
