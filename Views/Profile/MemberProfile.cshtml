                        <rect x="20" y="20" width="50" height="50" rx="4" fill="#1E1B4B" />
                        <rect x="28" y="28" width="34" height="34" rx="2" fill="white" />
                        <rect x="34" y="34" width="22" height="22" rx="2" fill="#7C3AED" />
