@model acm_amtics_website.Models.ProfileViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "My Profile";
    var p = Model?.Profile ?? new acm_amtics_website.Models.UserProfile();
    var publicSlug = acm_amtics_website.Models.UserProfile.GenerateSlug(p.Email);
    var earnedBadgesCount = Model?.Badges?.Count(b => b.Earned) ?? 0;
    var eventsCount = Model?.AttendedEvents?.Count ?? 0;
    var rolesCount = Model?.CoordinatorRoles?.Count ?? 0;
}

<!-- Profile Page Container -->
<div class="profile-page-wrapper">
    <!-- Ambient Background Lighting & Doodles -->
    <div class="profile-ambient-bg" aria-hidden="true">
        <div class="profile-glow-orb"></div>
        <div class="profile-dot-grid"></div>
        <div class="profile-doodle-quote">
            Ideas<br />
            Community<br />
            Technology<br />
            Impact
            <svg class="profile-doodle-arrow" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round">
                <path d="M 20 20 Q 80 40 40 85 M 40 85 L 55 70 M 40 85 L 30 65" />
            </svg>
        </div>
    </div>

    <!-- Breadcrumb Row -->
    <nav class="profile-breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/Dashboard">
            <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span>Home</span>
        </a>
        <span class="breadcrumb-sep">&rsaquo;</span>
        <span class="breadcrumb-current">Profile</span>
    </nav>

    <!-- Page Title Header -->
    <div class="profile-header-titles">
        <h1 class="profile-main-title">
            My <span class="profile-title-gradient">Profile</span>
        </h1>
        <p class="profile-main-subtitle">
            Manage your profile, view your achievements, event history and submitted projects.
        </p>
    </div>

    <!-- Hero Profile Card -->
    <div class="profile-hero-card">
        <div class="profile-hero-left">
            <div class="profile-avatar-container">
                <div class="profile-avatar-circle" style="width: 100%; height: 100%; border-radius: 50%; background: linear-gradient(135deg, #9333ea, #6d28d9); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 2.25rem; font-weight: 800;">
                    @(!string.IsNullOrWhiteSpace(p.Name) ? p.Name.Substring(0, 1).ToUpper() : "M")
                </div>
            </div>

            <div class="profile-info-group">
                <div class="profile-name-row">
                    <h2 class="profile-user-name user-profile-name">@p.Name</h2>
                    <span class="profile-member-badge">@(Model?.MemberRecord?.Role ?? "Member")</span>
                </div>
                <div class="profile-user-headline user-profile-dept">
                    @p.AcademicYear &bull; @p.Department
                </div>
                <div class="profile-meta-row">
                    <div class="profile-meta-item">
                        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <span class="user-profile-email">@p.Email</span>
                    </div>
                    <div class="profile-meta-item">
                        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span class="user-profile-college">@p.College</span>
                    </div>
                </div>
                <p class="profile-user-bio user-profile-bio">
                    @p.Bio
                </p>
            </div>
        </div>

        <div class="profile-hero-right">
            <div class="profile-quote-card">
                <span class="profile-quote-icon">&ldquo;</span>
                <span class="profile-quote-text">
                    <span class="user-profile-quote">@p.Quote</span>
                    <span class="profile-quote-rocket">&nbsp;&nbsp;&#128640;</span>
                </span>
            </div>

            <div class="profile-actions-row">
                <button type="button" class="btn-edit-profile" onclick="openEditProfileModal()">
                    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                    <span>Edit Profile</span>
                </button>
                <a href="/profile/@publicSlug" class="btn-preview-public" title="View Public Member Profile">
                    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    <span>Public View</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 4 Key Stat Metric Cards Row -->
    <div class="profile-stats-grid">
        <!-- Badges Earned -->
        <div class="profile-stat-card" onclick="switchProfileTab('badges', document.getElementById('tabBtn-badges'))">
            <div class="profile-stat-left">
                <div class="profile-stat-icon-wrap">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    </svg>
                </div>
                <div class="profile-stat-data">
                    <span class="profile-stat-number" id="statBadgesNum">@earnedBadgesCount</span>
                    <span class="profile-stat-label">Badges Earned</span>
                </div>
            </div>
            <div class="profile-stat-arrow-btn">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </div>
        </div>

        <!-- Events Attended -->
        <div class="profile-stat-card" onclick="switchProfileTab('events', document.getElementById('tabBtn-events'))">
            <div class="profile-stat-left">
                <div class="profile-stat-icon-wrap">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div class="profile-stat-data">
                    <span class="profile-stat-number" id="statEventsNum">@eventsCount</span>
                    <span class="profile-stat-label">Events Attended</span>
                </div>
            </div>
            <div class="profile-stat-arrow-btn">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </div>
        </div>

        <!-- Projects Submitted -->
        <div class="profile-stat-card" onclick="switchProfileTab('projects', document.getElementById('tabBtn-projects'))">
            <div class="profile-stat-left">
                <div class="profile-stat-icon-wrap">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                </div>
                <div class="profile-stat-data">
                    <span class="profile-stat-number" id="statProjectsNum">0</span>
                    <span class="profile-stat-label">Projects Submitted</span>
                </div>
            </div>
            <div class="profile-stat-arrow-btn">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </div>
        </div>

        <!-- Coordinator Roles -->
        <div class="profile-stat-card" onclick="switchProfileTab('roles', document.getElementById('tabBtn-roles'))">
            <div class="profile-stat-left">
                <div class="profile-stat-icon-wrap">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-3.512M9 20H4v-2a3 3 0 015-3.512M12 11a4 4 0 100-8 4 4 0 000 8zm0 2a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                <div class="profile-stat-data">
                    <span class="profile-stat-number" id="statRolesNum">@rolesCount</span>
                    <span class="profile-stat-label">Coordinator Roles</span>
                </div>
            </div>
            <div class="profile-stat-arrow-btn">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </div>
        </div>
    </div>

    <!-- Horizontal Tab Navigation Bar -->
    <div class="profile-tabs-wrapper">
        <div class="profile-tabs-list" role="tablist">
            <button type="button" class="profile-tab-item active" id="tabBtn-overview" onclick="switchProfileTab('overview', this)">
                Overview
            </button>
            <button type="button" class="profile-tab-item" id="tabBtn-badges" onclick="switchProfileTab('badges', this)">
                Badges
            </button>
            <button type="button" class="profile-tab-item" id="tabBtn-events" onclick="switchProfileTab('events', this)">
                Event History
            </button>
            <button type="button" class="profile-tab-item" id="tabBtn-projects" onclick="switchProfileTab('projects', this)">
                Submitted Projects
            </button>
            <button type="button" class="profile-tab-item" id="tabBtn-roles" onclick="switchProfileTab('roles', this)">
                Coordinator Roles
            </button>
            <button type="button" class="profile-tab-item" id="tabBtn-activity" onclick="switchProfileTab('activity', this)">
                Activity
            </button>
        </div>
    </div>

    <!-- ==============================================
         TAB 1: OVERVIEW (Matching Screenshot 1)
         ============================================== -->
    <div class="profile-tab-section" id="tabSection-overview">
        <div class="profile-content-grid">
            <!-- Main Left Column -->
            <div class="profile-main-col">
                <!-- My Badges Section Card -->
                <div class="profile-section-card">
                    <div class="profile-card-header">
                        <div class="profile-card-header-left">
                            <div class="profile-card-header-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                                </svg>
                            </div>
                            <div class="profile-card-titles">
                                <h3 class="profile-card-title">My Badges</h3>
                                <p class="profile-card-subtitle">Recognition for your participation and contributions.</p>
                            </div>
                        </div>
                        <a href="javascript:void(0)" class="profile-card-action-link" onclick="switchProfileTab('badges', document.getElementById('tabBtn-badges'))">
                            View All Badges &rarr;
                        </a>
                    </div>

                    <!-- Badges Row (Dynamically populated from JS) -->
                    <div class="profile-badges-row" id="profileBadgesContainer">
                        <!-- Populated by profile.js -->
                    </div>
                </div>

                <!-- Sub-grid: Recent Events & Submitted Projects -->
                <div class="profile-sub-cards-grid">
                    <!-- Recent Events Card -->
                    <div class="profile-section-card">
                        <div class="profile-card-header">
                            <div class="profile-card-header-left">
                                <div class="profile-card-header-icon">
                                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <div class="profile-card-titles">
                                    <h3 class="profile-card-title">Recent Events</h3>
                                    <p class="profile-card-subtitle">A record of the events and workshops you have attended.</p>
                                </div>
                            </div>
                            <a href="javascript:void(0)" class="profile-card-action-link" onclick="switchProfileTab('events', document.getElementById('tabBtn-events'))">
                                View All Events &rarr;
                            </a>
                        </div>

                        <!-- Recent Events Items -->
                        <div class="profile-items-list" id="recentEventsList">
                            <!-- Populated by profile.js -->
                        </div>
                    </div>

                    <!-- Submitted Projects Card -->
                    <div class="profile-section-card">
                        <div class="profile-card-header">
                            <div class="profile-card-header-left">
                                <div class="profile-card-header-icon">
                                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                                    </svg>
                                </div>
                                <div class="profile-card-titles">
                                    <h3 class="profile-card-title">Submitted Projects</h3>
                                    <p class="profile-card-subtitle">Your submitted projects through the Google Form.</p>
                                </div>
                            </div>
                            <a href="javascript:void(0)" class="profile-card-action-link" onclick="switchProfileTab('projects', document.getElementById('tabBtn-projects'))">
                                View All Projects &rarr;
                            </a>
                        </div>

                        <!-- Submitted Projects Items -->
                        <div class="profile-items-list" id="submittedProjectsList">
                            <!-- Populated by profile.js -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Sidebar Column -->
            <div class="profile-side-col">
                <!-- Quick Info Card -->
                <div class="profile-section-card">
                    <div class="profile-card-header" style="margin-bottom:1.15rem;">
                        <div class="profile-card-header-left">
                            <div class="profile-card-header-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <div class="profile-card-titles">
                                <h3 class="profile-card-title">Quick Info</h3>
                            </div>
                        </div>
                    </div>

                    <div class="quick-info-list">
                        <div class="quick-info-item">
                            <div class="quick-info-icon-wrap">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div class="quick-info-content">
                                <span class="quick-info-label">Member Since</span>
                                <span class="quick-info-val">@p.MemberSince</span>
                            </div>
                        </div>

                        <div class="quick-info-item">
                            <div class="quick-info-icon-wrap">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                                </svg>
                            </div>
                            <div class="quick-info-content">
                                <span class="quick-info-label">Academic Year</span>
                                <span class="quick-info-val user-profile-year">@p.AcademicYear</span>
                            </div>
                        </div>

                        <div class="quick-info-item">
                            <div class="quick-info-icon-wrap">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                            </div>
                            <div class="quick-info-content">
                                <span class="quick-info-label">Department</span>
                                <span class="quick-info-val user-profile-dept-text">@p.Department</span>
                            </div>
                        </div>

                        <div class="quick-info-item">
                            <div class="quick-info-icon-wrap">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                </svg>
                            </div>
                            <div class="quick-info-content">
                                <span class="quick-info-label">College</span>
                                <span class="quick-info-val user-profile-college">@p.College</span>
                            </div>
                        </div>
                    </div>

                    <!-- Big CTA: Open My Event Ticket (Image 2 trigger) -->
                    <button type="button" class="btn-open-ticket" onclick="openEventTicketModal()" id="btnOpenEventTicket">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                        </svg>
                        <span>Open My Event Ticket &rarr;</span>
                    </button>
                </div>

                <!-- Coordinator Roles Card -->
                <div class="profile-section-card">
                    <div class="profile-card-header">
                        <div class="profile-card-header-left">
                            <div class="profile-card-header-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-3.512M9 20H4v-2a3 3 0 015-3.512M12 11a4 4 0 100-8 4 4 0 000 8zm0 2a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <div class="profile-card-titles">
                                <h3 class="profile-card-title">Coordinator Roles</h3>
                                <p class="profile-card-subtitle">Your leadership and coordination experience.</p>
                            </div>
                        </div>
                        <a href="javascript:void(0)" class="profile-card-action-link" onclick="switchProfileTab('roles', document.getElementById('tabBtn-roles'))">
                            View All Roles &rarr;
                        </a>
                    </div>

                    <!-- Coordinator Roles Items -->
                    <div class="profile-items-list" id="coordinatorRolesList">
                        <!-- Populated by profile.js -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Campus Illustration & Handwritten Doodles at bottom -->
        <div class="profile-bottom-campus-decor">
            <img src="/images/amtics-building.jpg" alt="AMTICS Campus" class="campus-thumb-decor" onerror="this.src='/images/events/ui-ux-workshop.jpg'" />
            <div>
                <div class="campus-doodle-text">
                    Learn &bull; Collaborate &bull; Build &bull; Create Impact
                    <svg class="campus-doodle-arrow" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round">
                        <path d="M 10 50 Q 50 10 80 50 M 80 50 L 65 35 M 80 50 L 65 65" />
                    </svg>
                </div>
                <p style="font-size:0.8125rem; color:#6B7280; margin-top:0.25rem;">
                    Empowering students to solve real problems through computer science excellence at AMTICS.
                </p>
            </div>
        </div>
    </div>

    <!-- ==============================================
         TAB 2: BADGES (Detailed view)
         ============================================== -->
    <div class="profile-tab-section" id="tabSection-badges" style="display:none;">
        <div class="profile-section-card">
            <div class="profile-card-header">
                <div>
                    <h2 class="profile-card-title" style="font-size:1.35rem;">ACM AMTICS Recognition & Badges</h2>
                    <p class="profile-card-subtitle">Badges are automatically awarded when criteria are achieved. Click any badge to view requirements.</p>
                </div>
                <button type="button" class="btn-primary-purple" onclick="switchProfileTab('overview', document.getElementById('tabBtn-overview'))" style="font-size:0.8125rem; padding:0.4rem 0.9rem;">
                    &larr; Back to Overview
                </button>
            </div>

            <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap:1.25rem; margin-top:1.5rem;">
                @if (Model?.Badges != null && Model.Badges.Any())
                {
                    @foreach (var badge in Model.Badges)
                    {
                        <div class="profile-event-row" style="padding:1.25rem;">
                            <div style="display:flex; align-items:center; gap:1.25rem;">
                                <div class="badge-shape-wrap" style="width:70px; height:70px; margin:0;">
                                    <svg class="badge-hex-svg" viewBox="0 0 100 100" fill="none">
                                        <defs>
                                            <linearGradient id="det-b-@badge.Id" x1="0%" y1="0%" x2="100%" y2="100%">
                                                <stop offset="0%" stop-color="@(badge.Earned ? "#8B5CF6" : "#94A3B8")" />
                                                <stop offset="100%" stop-color="@(badge.Earned ? "#6D28D9" : "#64748B")" />
                                            </linearGradient>
                                        </defs>
                                        <polygon points="50,4 90,26 90,74 50,96 10,74 10,26" fill="url(#det-b-@badge.Id)" />
                                    </svg>
                                    <div class="badge-icon-overlay">
                                        <svg width="26" height="26" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                    </div>
                                </div>
                                <div>
                                    <div style="font-weight:700; font-size:1rem; color:#111827;">@badge.Title</div>
                                    <div style="font-size:0.8125rem; color:#6B7280; margin-top:0.2rem;">@badge.Description</div>
                                    <div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.5rem;">
                                        <span class="badge-status-pill @(badge.Earned ? "badge-status-unlocked" : "badge-status-locked")">
                                            @(badge.Earned ? "Earned ✓" : "Locked")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="font-size:0.875rem; color:#6B7280;">No badges found.</p>
                }
            </div>
        </div>
    </div>

    <!-- ==============================================
         TAB 3: EVENT HISTORY
         ============================================== -->
    <div class="profile-tab-section" id="tabSection-events" style="display:none;">
        <div class="profile-section-card">
            <div class="profile-card-header">
                <div>
                    <h2 class="profile-card-title" style="font-size:1.35rem;">Attended Events History (@eventsCount Total)</h2>
                    <p class="profile-card-subtitle">Official check-in record of your attendance at ACM AMTICS workshops, seminars, and hackathons.</p>
                </div>
                <button type="button" class="btn-open-ticket" onclick="openEventTicketModal()" style="width:auto; padding:0.5rem 1rem; font-size:0.8125rem;">
                    View Event Ticket
                </button>
            </div>

            <div class="profile-items-list" style="margin-top:1.25rem;">
                @if (Model?.AttendedEvents != null && Model.AttendedEvents.Any())
                {
                    @foreach (var evt in Model.AttendedEvents)
                    {
                        <div class="profile-event-row">
                            <div class="profile-event-left">
                                <img src="@(string.IsNullOrWhiteSpace(evt.ImageUrl) ? "/images/events/ui-ux-workshop.jpg" : evt.ImageUrl)" alt="@evt.Name" class="profile-item-thumb" onerror="this.src='/images/events/ui-ux-workshop.jpg'" />
                                <div class="profile-item-info">
                                    <div class="profile-item-name">@evt.Name</div>
                                    <div class="profile-item-meta">@evt.Date.ToString("dd MMM yyyy") &bull; @(evt.Venue ?? "AMTICS Campus")</div>
                                </div>
                            </div>
                            <div class="profile-event-right">
                                <span class="pill-tag pill-tag-workshop">@(evt.Category ?? "Event")</span>
                                <span class="pill-status-attended">&check; Attended</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="font-size:0.875rem; color:#6B7280; padding:1rem 0;">No attended events recorded yet.</p>
                }
            </div>
        </div>
    </div>

    <!-- ==============================================
         TAB 4: SUBMITTED PROJECTS
         ============================================== -->
    <div class="profile-tab-section" id="tabSection-projects" style="display:none;">
        <div class="profile-section-card">
            <div class="profile-card-header">
                <div>
                    <h2 class="profile-card-title" style="font-size:1.35rem;">Submitted Projects</h2>
                    <p class="profile-card-subtitle">Projects submitted for chapter showcase, hackathon entries, or review.</p>
                </div>
                <a href="@Model?.FormGoogleUrl" target="_blank" rel="noopener noreferrer" class="btn-primary-purple" style="font-size:0.875rem; padding:0.6rem 1.15rem; text-decoration:none;">
                    + Submit New Project (Google Form)
                </a>
            </div>

            <div style="margin-top:1.5rem; background:#F9FAFB; border:2px dashed #E5E7EB; border-radius:16px; padding:3rem 2rem; text-align:center;">
                <div style="width:60px; height:60px; border-radius:50%; background:#EDE9FE; color:#7C3AED; display:flex; align-items:center; justify-content:center; margin:0 auto 1.25rem auto;">
                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                </div>
                <h3 style="font-size:1.15rem; font-weight:700; color:#111827; margin-bottom:0.5rem;">No Submitted Projects</h3>
                <p style="font-size:0.875rem; color:#6B7280; max-width:480px; margin:0 auto 1.5rem auto; line-height:1.5;">
                    You haven't submitted any projects yet. Click below to open the official Google Form and submit your project to the chapter showcase.
                </p>
                <a href="@Model?.FormGoogleUrl" target="_blank" rel="noopener noreferrer" class="btn-primary-purple" style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.65rem 1.35rem; text-decoration:none;">
                    <span>Open Google Form</span>
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <!-- ==============================================
         TAB 5: COORDINATOR ROLES
         ============================================== -->
    <div class="profile-tab-section" id="tabSection-roles" style="display:none;">
        <div class="profile-section-card">
            <div class="profile-card-header">
                <div>
                    <h2 class="profile-card-title" style="font-size:1.35rem;">Leadership & Coordinator Experience (@rolesCount Total)</h2>
                    <p class="profile-card-subtitle">Roles where you helped coordinate, lead, and organize student chapter activities.</p>
                </div>
            </div>

            <div class="profile-items-list" style="margin-top:1.25rem;">
                @if (Model?.CoordinatorRoles != null && Model.CoordinatorRoles.Any())
                {
                    @foreach (var role in Model.CoordinatorRoles)
                    {
                        <div class="profile-event-row" style="padding:1.25rem;">
                            <div class="profile-event-left">
                                <img src="@(string.IsNullOrWhiteSpace(role.Image) ? "/images/events/ui-ux-workshop.jpg" : role.Image)" alt="@role.EventName" class="profile-item-thumb" style="width:60px; height:60px;" onerror="this.src='/images/events/ui-ux-workshop.jpg'" />
                                <div class="profile-item-info">
                                    <div class="profile-item-name" style="font-size:1.05rem;">@role.EventName</div>
                                    <div style="font-weight:600; color:#4B5563; font-size:0.875rem;">@role.RoleTitle</div>
                                    <div class="profile-item-meta">Date: @role.Date</div>
                                </div>
                            </div>
                            <div class="profile-event-right">
                                <span class="@(role.Status == "Current" ? "role-badge-current" : "role-badge-past")" style="font-size:0.8125rem; padding:0.3rem 0.8rem;">@role.Status</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="font-size:0.875rem; color:#6B7280; padding:1rem 0;">No coordinator assignments on record.</p>
                }
            </div>
        </div>
    </div>

    <!-- ==============================================
         TAB 6: ACTIVITY
         ============================================== -->
    <div class="profile-tab-section" id="tabSection-activity" style="display:none;">
        <div class="profile-section-card">
            <h2 class="profile-card-title" style="font-size:1.35rem; margin-bottom:1rem;">Recent Activity Timeline</h2>
            <div style="display:flex; flex-direction:column; gap:1.25rem; border-left:2px solid #EDE9FE; padding-left:1.5rem; margin-left:0.75rem;">
                @if (Model?.AttendedEvents != null && Model.AttendedEvents.Any())
                {
                    @foreach (var evt in Model.AttendedEvents)
                    {
                        <div>
                            <span style="font-size:0.75rem; color:#8B5CF6; font-weight:700;">@evt.Date.ToString("dd MMM yyyy").ToUpper()</span>
                            <div style="font-weight:700; color:#111827; margin-top:0.15rem;">Attended "@evt.Name"</div>
                            <p style="font-size:0.8125rem; color:#6B7280;">Checked in at @(evt.Venue ?? "AMTICS Campus")</p>
                        </div>
                    }
                }
                else
                {
                    <p style="font-size:0.875rem; color:#6B7280;">No recent activity recorded.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- ==============================================
     MODAL 1: MY EVENT TICKET (Exact Image 2)
     ============================================== -->
<div class="modal-overlay-custom" id="eventTicketModal" role="dialog" aria-modal="true" aria-labelledby="ticketTitle">
    <div class="ticket-modal-card">
        <!-- Modal Top Bar -->
        <div class="ticket-modal-header">
            <div class="ticket-modal-header-left">
                <div class="ticket-modal-icon-badge">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                    </svg>
                </div>
                <div>
                    <h3 class="ticket-modal-title" id="ticketTitle">My Event Ticket</h3>
                    <p class="ticket-modal-subtitle">Use this ticket to check-in at any ACM AMTICS event.</p>
                </div>
            </div>
            <button type="button" class="ticket-modal-close-btn" onclick="closeEventTicketModal()" aria-label="Close modal">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- The Physical Digital Pass (Cutouts & Perforation) -->
        <div class="digital-ticket-pass" id="printableTicketPass">
            <!-- Top Section of Pass -->
            <div class="ticket-top-section">
                <!-- Chapter Logo -->
                <div class="ticket-logo-row">
                    <img src="/images/acm-logo.svg" alt="ACM AMTICS" class="ticket-logo-img" />
                    <div class="ticket-brand-text">
                        <div class="ticket-brand-title">ACM AMTICS</div>
                        <div class="ticket-brand-subtitle">Student Chapter</div>
                    </div>
                </div>

                <!-- Member Pill Badge -->
                <div class="ticket-role-pill">MEMBER</div>

                <!-- Member Name & Department -->
                <div class="ticket-holder-name" id="ticketHolderName">@p.Name</div>
                <div class="ticket-holder-dept" id="ticketHolderDept">@p.AcademicYear &bull; @p.Department</div>
                
                <!-- High-res crisp QR code centered -->
                <div class="ticket-qr-container">
                    <svg class="ticket-qr-code-svg" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Background -->
                        <rect width="200" height="200" fill="white" />
                        <!-- QR Corner Markers -->
                        <!-- Top-Left Marker -->
                        <rect x="20" y="20" width="50" height="50" rx="4" fill="#1E1B4B" />
                        <rect x="28" y="28" width="34" height="34" rx="2" fill="white" />
                        <rect x="34" y="34" width="22" height="22" rx="2" fill="#7C3AED" />
                        <!-- Top-Right Marker -->
                        <rect x="130" y="20" width="50" height="50" rx="4" fill="#1E1B4B" />
                        <rect x="138" y="28" width="34" height="34" rx="2" fill="white" />
                        <rect x="144" y="34" width="22" height="22" rx="2" fill="#7C3AED" />
                        <!-- Bottom-Left Marker -->
                        <rect x="20" y="130" width="50" height="50" rx="4" fill="#1E1B4B" />
                        <rect x="28" y="138" width="34" height="34" rx="2" fill="white" />
                        <rect x="34" y="144" width="22" height="22" rx="2" fill="#7C3AED" />
                        <!-- Data Modules / Pattern -->
                        <rect x="80" y="24" width="10" height="10" fill="#1E1B4B" />
                        <rect x="100" y="24" width="10" height="10" fill="#1E1B4B" />
                        <rect x="80" y="44" width="10" height="10" fill="#7C3AED" />
                        <rect x="94" y="54" width="12" height="12" fill="#1E1B4B" />
                        <rect x="110" y="40" width="10" height="10" fill="#7C3AED" />
                        
                        <rect x="24" y="80" width="10" height="10" fill="#1E1B4B" />
                        <rect x="44" y="84" width="12" height="10" fill="#1E1B4B" />
                        <rect x="60" y="80" width="10" height="10" fill="#7C3AED" />
                        <rect x="80" y="80" width="14" height="14" fill="#1E1B4B" />
                        <rect x="104" y="80" width="12" height="12" fill="#7C3AED" />
                        <rect x="130" y="84" width="12" height="12" fill="#1E1B4B" />
                        <rect x="154" y="80" width="10" height="10" fill="#1E1B4B" />
                        <rect x="170" y="84" width="10" height="10" fill="#7C3AED" />

                        <rect x="24" y="104" width="10" height="12" fill="#7C3AED" />
                        <rect x="44" y="104" width="10" height="10" fill="#1E1B4B" />
                        <rect x="64" y="104" width="10" height="10" fill="#1E1B4B" />
                        <rect x="84" y="104" width="12" height="12" fill="#7C3AED" />
                        <rect x="104" y="104" width="10" height="10" fill="#1E1B4B" />
                        <rect x="124" y="104" width="14" height="14" fill="#7C3AED" />
                        <rect x="150" y="104" width="10" height="10" fill="#1E1B4B" />
                        <rect x="170" y="104" width="10" height="10" fill="#1E1B4B" />

                        <rect x="80" y="130" width="10" height="10" fill="#1E1B4B" />
                        <rect x="100" y="134" width="12" height="10" fill="#7C3AED" />
                        <rect x="120" y="130" width="10" height="12" fill="#1E1B4B" />
                        <rect x="140" y="134" width="10" height="10" fill="#1E1B4B" />
                        <rect x="160" y="130" width="12" height="10" fill="#7C3AED" />
                        <rect x="176" y="134" width="10" height="10" fill="#1E1B4B" />

                        <rect x="80" y="154" width="12" height="12" fill="#7C3AED" />
                        <rect x="104" y="154" width="10" height="10" fill="#1E1B4B" />
                        <rect x="124" y="154" width="14" height="12" fill="#1E1B4B" />
                        <rect x="150" y="154" width="10" height="10" fill="#7C3AED" />
                        <rect x="170" y="154" width="12" height="12" fill="#1E1B4B" />
                    </svg>
                </div>

                <!-- Ticket Identifier code -->
                <div class="ticket-code-id" id="ticketCodeDisplay">#AMTICS-@publicSlug.ToUpper()</div>
            </div>

            <!-- Perforated Divider Line with Cutout Notches -->
            <div class="ticket-divider-row">
                <div class="ticket-notch-left"></div>
                <div class="ticket-dashed-line"></div>
                <div class="ticket-notch-right"></div>
            </div>

            <!-- Bottom Section (3 Columns) -->
            <div class="ticket-bottom-section">
                <!-- Col 1: Valid For All Events -->
                <div class="ticket-metric-box">
                    <div class="ticket-metric-icon">&infin;</div>
                    <div class="ticket-metric-label">Valid For All Events</div>
                    <div class="ticket-metric-sub">Use this ticket for every ACM AMTICS event.</div>
                </div>

                <!-- Col 2: Member Since -->
                <div class="ticket-metric-box">
                    <div class="ticket-metric-icon">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div class="ticket-metric-label">Member Since</div>
                    <div class="ticket-metric-sub" id="ticketMemberSince">@p.MemberSince</div>
                </div>

                <!-- Col 3: Authorized Member -->
                <div class="ticket-metric-box">
                    <div class="ticket-metric-icon">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    <div class="ticket-metric-label">Authorized Member</div>
                    <div class="ticket-metric-sub">Show this QR code at the registration desk.</div>
                </div>
            </div>
        </div>

        <!-- Keep ticket handy callout box -->
        <div class="ticket-alert-callout">
            <div class="ticket-alert-icon">&#9432;</div>
            <div class="ticket-alert-text">
                <strong>Keep this ticket handy</strong><br />
                You can always find this ticket in your profile and use it for all future events.
            </div>
        </div>

        <!-- Actions -->
        <div class="ticket-modal-actions">
            <button type="button" class="btn-ticket-download" onclick="printEventTicket()">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Print / Save Ticket</span>
            </button>
            <button type="button" class="btn-ticket-close" onclick="closeEventTicketModal()">
                Close
            </button>
        </div>
    </div>
</div>

<!-- ==============================================
     MODAL 2: EDIT PROFILE MODAL
     ============================================== -->
<div class="modal-overlay-custom" id="editProfileModal" role="dialog" aria-modal="true" aria-labelledby="editProfTitle">
    <div class="edit-profile-modal-card">
        <div class="ticket-modal-header">
            <div class="ticket-modal-header-left">
                <div class="ticket-modal-icon-badge">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                </div>
                <div>
                    <h3 class="ticket-modal-title" id="editProfTitle">Edit Profile</h3>
                    <p class="ticket-modal-subtitle">Update your profile information and chapter bio.</p>
                </div>
            </div>
            <button type="button" class="ticket-modal-close-btn" onclick="closeEditProfileModal()" aria-label="Close modal">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <form id="editProfileForm" onsubmit="saveProfileChanges(event)">
            @Html.AntiForgeryToken()
            <div class="edit-form-grid">
                <div class="form-group-custom">
                    <label for="editNameInput">Full Name</label>
                    <input type="text" id="editNameInput" class="form-input-custom" value="@p.Name" required />
                </div>
                <div class="form-group-custom">
                    <label for="editEmailInput">Email Address (Read-only)</label>
                    <input type="email" id="editEmailInput" class="form-input-custom" value="@p.Email" disabled style="opacity: 0.7; cursor: not-allowed;" />
                </div>
                <div class="form-group-custom">
                    <label for="editDeptInput">Department</label>
                    <input type="text" id="editDeptInput" class="form-input-custom" value="@p.Department" required />
                </div>
                <div class="form-group-custom">
                    <label for="editYearInput">Academic Year</label>
                    <input type="text" id="editYearInput" class="form-input-custom" value="@p.AcademicYear" required />
                </div>
                <div class="form-group-custom edit-form-full">
                    <label for="editCollegeInput">College & Campus (Read-only)</label>
                    <input type="text" id="editCollegeInput" class="form-input-custom" value="@p.College" disabled style="opacity: 0.7; cursor: not-allowed;" />
                </div>
                <div class="form-group-custom edit-form-full">
                    <label for="editBioInput">About Me / Bio</label>
                    <textarea id="editBioInput" class="form-input-custom" rows="3">@p.Bio</textarea>
                </div>
                <div class="form-group-custom edit-form-full">
                    <label for="editQuoteInput">Inspirational Quote</label>
                    <input type="text" id="editQuoteInput" class="form-input-custom" value="@p.Quote" />
                </div>
            </div>

            <div class="ticket-modal-actions" style="margin-top:1.5rem;">
                <button type="button" class="btn-ticket-close" onclick="closeEditProfileModal()">Cancel</button>
                <button type="submit" class="btn-ticket-download">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- ==============================================
     MODAL 3: SUBMIT PROJECT MODAL
     ============================================== -->
<div class="modal-overlay-custom" id="submitProjectModal" role="dialog" aria-modal="true" aria-labelledby="subProjTitle">
    <div class="edit-profile-modal-card">
        <div class="ticket-modal-header">
            <div class="ticket-modal-header-left">
                <div class="ticket-modal-icon-badge">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div>
                    <h3 class="ticket-modal-title" id="subProjTitle">Submit a Project</h3>
                    <p class="ticket-modal-subtitle">Share your work with ACM AMTICS review board.</p>
                </div>
            </div>
            <button type="button" class="ticket-modal-close-btn" onclick="closeSubmitProjectModal()" aria-label="Close modal">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <form id="submitProjectForm" onsubmit="handleProjectSubmit(event)">
            <div class="edit-form-grid">
                <div class="form-group-custom edit-form-full">
                    <label for="projTitleInput">Project Title</label>
                    <input type="text" id="projTitleInput" class="form-input-custom" placeholder="e.g. AI Smart Study Assistant" required />
                </div>
                <div class="form-group-custom edit-form-full">
                    <label for="projDescInput">Brief Description</label>
                    <textarea id="projDescInput" class="form-input-custom" placeholder="What does this project do and what technologies does it use?" rows="3" required></textarea>
                </div>
                <div class="form-group-custom edit-form-full">
                    <label for="projLinkInput">GitHub or Live Demo URL</label>
                    <input type="url" id="projLinkInput" class="form-input-custom" placeholder="https://github.com/username/project" />
                </div>
            </div>

            <div class="ticket-modal-actions" style="margin-top:1.5rem;">
                <button type="button" class="btn-ticket-close" onclick="closeSubmitProjectModal()">Cancel</button>
                <button type="submit" class="btn-ticket-download">Submit Project</button>
            </div>
        </form>
    </div>
</div>

<!-- ==============================================
     MODAL 4: BADGE DETAIL & UNLOCK MODAL
     ============================================== -->
<div class="modal-overlay-custom" id="badgeDetailModal" role="dialog" aria-modal="true" aria-labelledby="badgeDetailTitle">
    <div class="badge-modal-card">
        <div id="badgeDetailIconWrap"></div>
        <h3 id="badgeDetailTitle" style="font-size:1.4rem; font-weight:800; color:#111827;">Badge Title</h3>
        <p id="badgeDetailDesc" style="font-size:0.875rem; color:#6B7280; margin:0.75rem 0 1rem 0; line-height:1.5;">
            Badge description details here.
        </p>

        <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:12px; padding:1rem; margin-bottom:1.5rem;">
            <div style="font-size:0.75rem; font-weight:700; color:#6B7280; text-transform:uppercase;">Requirement Criteria</div>
            <div id="badgeDetailProgress" style="font-size:0.9375rem; font-weight:700; color:#7C3AED; margin-top:0.25rem;">
                Progress
            </div>
            <div style="margin-top:0.6rem;">
                <span id="badgeDetailStatus" class="badge-status-pill badge-status-unlocked">Earned ✓</span>
            </div>
        </div>

        <button type="button" class="btn-primary-purple" onclick="closeBadgeDetailModal()" style="width:100%; justify-content:center;">
            Awesome, Got It!
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile.js" asp-append-version="true"></script>
    <script>
        // Check for URL parameters (e.g. ?action=ticket or ?tab=projects)
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('action') === 'ticket') {
                openEventTicketModal();
            } else if (urlParams.get('action') === 'submit') {
                openSubmitProjectModal();
            }
            const tab = urlParams.get('tab');
            if (tab && document.getElementById(`tabBtn-${tab}`)) {
                switchProfileTab(tab, document.getElementById(`tabBtn-${tab}`));
            }
        });
    </script>
}
