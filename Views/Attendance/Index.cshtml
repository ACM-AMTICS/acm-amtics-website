@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Attendance";
}

<!-- Page Header Row -->
<div class="page-header-row">
    <div class="header-titles">
        <h1 class="page-title">Attendance</h1>
        <p class="page-subtitle">Track and review attendance logs for ACM AMTICS sessions and events.</p>
    </div>
</div>

<div class="card-section">
    <div class="card-section-header">
        <div class="header-left">
            <h2 class="section-title">Recent Event Attendance Logs</h2>
            <p class="section-subtitle">Real-time attendance recordings synced from the Attendance collection.</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="members-table">
            <thead>
                <tr>
                    <th class="col-num">#</th>
                    <th>Member Name</th>
                    <th>Event</th>
                    <th>Session Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="col-num">1</td>
                    <td>
                        <div class="member-name-cell">
                            <div class="member-avatar-initials">AS</div>
                            <span class="member-name-text">Aarav Sharma</span>
                        </div>
                    </td>
                    <td>ACM Hackathon 2024</td>
                    <td class="member-date-text">24 Sep 2026</td>
                    <td><span class="badge-status badge-status-active">Present</span></td>
                </tr>
                <tr>
                    <td class="col-num">2</td>
                    <td>
                        <div class="member-name-cell">
                            <div class="member-avatar-initials">NV</div>
                            <span class="member-name-text">Neha Verma</span>
                        </div>
                    </td>
                    <td>ACM Hackathon 2024</td>
                    <td class="member-date-text">24 Sep 2026</td>
                    <td><span class="badge-status badge-status-active">Present</span></td>
                </tr>
                <tr>
                    <td class="col-num">3</td>
                    <td>
                        <div class="member-name-cell">
                            <div class="member-avatar-initials">RM</div>
                            <span class="member-name-text">Rohan Mehta</span>
                        </div>
                    </td>
                    <td>Web Dev Bootcamp 2024</td>
                    <td class="member-date-text">22 Sep 2026</td>
                    <td><span class="badge-status badge-status-active">Present</span></td>
                </tr>
                <tr>
                    <td class="col-num">4</td>
                    <td>
                        <div class="member-name-cell">
                            <div class="member-avatar-initials">PS</div>
