@model acm_amtics_website.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-page-container">
    <div class="login-content-wrapper">
        <!-- Left Column: Login Form -->
        <div class="login-left-section">
            <!-- Welcome Badge -->
            <div class="welcome-pill">
                <svg class="pill-sparkle" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                </svg>
                <span>Welcome to ACM AMTICS</span>
            </div>

            <!-- Page Title & Subtitle -->
            <h1 class="login-title">Welcome <span class="highlight-text">Back</span></h1>
            <p class="login-subtitle">Login to continue to ACM AMTICS</p>

            <!-- Card -->
            <div class="login-card">
                <!-- Flash Messages & Validation -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-success-box">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-error-box">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="login-form">
                    @Html.AntiForgeryToken()

                    <!-- Email Field -->
                    <div class="form-group">
                        <label class="input-label" asp-for="Email">Email Address</label>
                        <div class="input-field-wrapper">
                            <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                            <input asp-for="Email" class="form-control-custom" placeholder="Enter your email address" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="form-group">
                        <label class="input-label" asp-for="Password">Password</label>
                        <div class="input-field-wrapper">
                            <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                            <input asp-for="Password" id="passwordInput" type="password" class="form-control-custom" placeholder="Enter your password" autocomplete="current-password" />
                            <button type="button" id="togglePasswordBtn" class="input-icon-right" aria-label="Toggle password visibility">
                                <svg id="eyeIcon" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <!-- Form Options Row -->
                    <div class="form-options-row">
                        <label class="remember-me-label">
                            <input asp-for="RememberMe" class="custom-checkbox" type="checkbox" />
                            <span>Remember me</span>
                        </label>
                        <a href="javascript:void(0);" class="forgot-password-link">Forgot Password?</a>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-submit-primary">
                        <span>Login</span>
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </button>

                    <!-- Info Box -->
                    <div class="admin-info-box">
                        <div class="info-icon-wrapper">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                        <div class="info-content">
                            <div class="info-title">Only authorized members can access this platform.</div>
                            <div class="info-desc">No self-signup. Use the credentials issued by the Admin.</div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Back to Home Link -->
            <a href="/" class="back-home-link">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Back to Home</span>
            </a>
        </div>

        <!-- Right Column: Hero Orbit Graphics & Branding -->
        <div class="login-right-section">
            <div class="orbit-hero-container">
                <!-- Outer Dotted Orbit Ring -->
                <div class="orbit-ring">
                    <!-- Orbit Nodes -->
                    <div class="orbit-dot dot-1"></div>
                    <div class="orbit-dot dot-2"></div>
                    <div class="orbit-dot dot-3"></div>
                    <div class="orbit-dot dot-4"></div>
                </div>

                <!-- 4 Satellite Icons around Orbit -->
                <!-- Top Left: Code -->
                <div class="satellite-badge satellite-top-left">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                </div>
                <!-- Top Right: Bulb -->
                <div class="satellite-badge satellite-top-right">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                    </svg>
                </div>
                <!-- Bottom Left: Community -->
                <div class="satellite-badge satellite-bottom-left">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-3.512M9 20H4v-2a3 3 0 015-3.512M12 11a4 4 0 100-8 4 4 0 000 8zm0 2a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                <!-- Bottom Right: Gear -->
                <div class="satellite-badge satellite-bottom-right">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>

                <!-- Central Logo Badge with glowing cyan & purple rings -->
                <div class="center-logo-glow-ring">
                    <div class="center-logo-inner-ring">
                        <img src="~/images/acm-logo.svg" alt="ACM AMTICS Logo" class="orbit-center-logo" />
                    </div>
                </div>

                <!-- Handwritten Callout 1 (Top Left) -->
                <div class="handwritten-callout callout-top-left">
                    <span>Ideas</span>
                    <span>Community</span>
                    <span>Technology</span>
                    <span>Impact</span>
                    <svg class="callout-arrow arrow-tl" width="45" height="32" viewBox="0 0 50 40" fill="none">
                        <path d="M10 5 C 25 18, 30 12, 42 30" stroke="#9333ea" stroke-width="1.8" stroke-dasharray="3 3" fill="none" />
                        <path d="M35 27 L 43 31 L 42 22" stroke="#9333ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    </svg>
                </div>

                <!-- Handwritten Callout 2 (Right / Bottom Right) -->
                <div class="handwritten-callout callout-bottom-right">
                    <span>Learn</span>
                    <span>Collaborate</span>
                    <span>Build</span>
                    <span>Create Impact</span>
                    <svg class="callout-arrow arrow-br" width="45" height="32" viewBox="0 0 50 40" fill="none">
                        <path d="M42 5 C 28 15, 20 18, 8 28" stroke="#9333ea" stroke-width="1.8" stroke-dasharray="3 3" fill="none" />
                        <path d="M14 23 L 7 28 L 13 33" stroke="#9333ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    </svg>
                </div>
            </div>

            <!-- Branding Text Below Orbit -->
            <div class="right-brand-footer">
                <h2 class="brand-title">ACM AMTICS</h2>
                <p class="brand-subtitle">Association for Computing Machinery</p>
                <div class="brand-tagline">
                    BUILD &nbsp;&bull;&nbsp; COLLABORATE &nbsp;&bull;&nbsp; INSPIRE
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const togglePasswordBtn = document.getElementById("togglePasswordBtn");
            const passwordInput = document.getElementById("passwordInput");
            const eyeIcon = document.getElementById("eyeIcon");

            if (togglePasswordBtn && passwordInput) {
                togglePasswordBtn.addEventListener("click", function () {
                    const isPassword = passwordInput.getAttribute("type") === "password";
                    passwordInput.setAttribute("type", isPassword ? "text" : "password");
                    
                    if (isPassword) {
                        eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908a8.962 8.962 0 014.122-.963c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21M3 3l18 18" />`;
                    } else {
                        eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;
                    }
                });
            }
        });
    </script>
}

