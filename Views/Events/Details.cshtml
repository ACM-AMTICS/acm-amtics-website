@model acm_amtics_website.Models.EventItem
@{
    Layout = "_Layout";
    ViewData["Title"] = $"{Model?.Name ?? "Event Details"} - ACM AMTICS";
    var catLower = (Model?.Category ?? "Workshop").ToLowerInvariant();
    var badgeClass = catLower switch
    {
        "workshop" => "category-workshop",
        "seminar" => "category-seminar",
        "competition" => "category-competition",
        "hackathon" => "category-competition",
        "talk" => "category-talk",
        _ => "category-workshop"
    };

    var fallbackImg = catLower switch
    {
        "workshop" => "/images/events/web-dev-workshop.jpg",
        "seminar" => "/images/events/ai-ml-intro.jpg",
        "competition" => "/images/events/acm-hackathon.jpg",
        "hackathon" => "/images/events/acm-hackathon.jpg",
        "talk" => "/images/events/open-source-session.jpg",
        _ => "/images/events/ui-ux-workshop.jpg"
    };

    var eventImg = !string.IsNullOrWhiteSpace(Model?.ImageUrl) ? Model.ImageUrl : fallbackImg;
    var dateFormatted = Model?.Date.ToString("dddd, dd MMMM yyyy") ?? "Date TBA";
    var isCompleted = !string.Equals(Model?.Status, "Upcoming", StringComparison.OrdinalIgnoreCase);
}

<!-- Ambient Background -->
<div class="events-ambient-bg" aria-hidden="true">
    <div class="events-blob-top-left"></div>
    <div class="events-blob-top-right"></div>
</div>

<div class="event-details-page-wrapper">
    <div class="event-details-container">

        <!-- Top Navigation / Breadcrumb -->
        <div class="event-details-top-bar">
            <a href="/Events" class="back-to-events-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Back to Events</span>
            </a>

            <nav class="events-breadcrumb-wrapper" aria-label="Breadcrumb" style="margin-bottom: 0;">
                <ol class="events-breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/" class="breadcrumb-link">Home</a>
                    </li>
                    <li class="breadcrumb-separator" aria-hidden="true">&gt;</li>
                    <li class="breadcrumb-item">
                        <a href="/Events" class="breadcrumb-link">Events</a>
                    </li>
                    <li class="breadcrumb-separator" aria-hidden="true">&gt;</li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <span>@(Model?.Name ?? "Event")</span>
                    </li>
                </ol>
            </nav>
        </div>

        <!-- Event Main Hero Showcase Card -->
        <article class="event-details-card">
            <!-- Media Banner -->
            <div class="event-details-banner">
                <img src="@eventImg" alt="@(Model?.Name ?? "Event banner")" class="banner-img" onerror="this.onerror=null; this.src='@fallbackImg';" />
                <div class="banner-gradient-overlay"></div>
                
                <div class="banner-badge-tags">
                    <span class="event-category-pill @badgeClass">@(Model?.Category ?? "Workshop")</span>
                    <span class="event-status-pill @(isCompleted ? "status-completed" : "status-upcoming")">
                        @(isCompleted ? "Completed Event" : "Upcoming Event")
                    </span>
                </div>
            </div>

            <!-- Content Body -->
            <div class="event-details-body">
                <h1 class="event-details-title">@(Model?.Name ?? "Event Title")</h1>

                <!-- Key Meta Highlights Grid -->
                <div class="event-meta-grid">
                    <div class="meta-item-box">
                        <div class="meta-box-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <rect x="3" y="4" width="18" height="18" rx="2" stroke-width="2"/>
                                <line x1="16" y1="2" x2="16" y2="6" stroke-width="2"/>
                                <line x1="8" y1="2" x2="8" y2="6" stroke-width="2"/>
                                <line x1="3" y1="10" x2="21" y2="10" stroke-width="2"/>
                            </svg>
                        </div>
                        <div class="meta-box-text">
                            <span class="meta-box-label">Date</span>
                            <span class="meta-box-val">@dateFormatted</span>
                        </div>
                    </div>

                    <div class="meta-item-box">
                        <div class="meta-box-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <circle cx="12" cy="12" r="10" stroke-width="2" />
                                <polyline points="12 6 12 12 16 14" stroke-width="2" />
                            </svg>
                        </div>
                        <div class="meta-box-text">
                            <span class="meta-box-label">Time</span>
                            <span class="meta-box-val">@(string.IsNullOrWhiteSpace(Model?.Time) ? "10:00 AM - 1:00 PM" : Model.Time)</span>
                        </div>
                    </div>

                    <div class="meta-item-box">
                        <div class="meta-box-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <div class="meta-box-text">
                            <span class="meta-box-label">Venue</span>
                            <span class="meta-box-val">@(string.IsNullOrWhiteSpace(Model?.Venue) ? "Seminar Hall, AMTICS" : Model.Venue)</span>
                        </div>
                    </div>

                    <div class="meta-item-box">
                        <div class="meta-box-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-3.512M9 20H4v-2a3 3 0 015-3.512M12 11a4 4 0 100-8 4 4 0 000 8zm0 2a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        <div class="meta-box-text">
                            <span class="meta-box-label">Attendees</span>
                            <span class="meta-box-val">@((Model?.AttendeesCount ?? 0) > 0 ? $"{Model?.AttendeesCount} Participants" : (isCompleted ? "80+ Participants" : "Registration Open"))</span>
                        </div>
                    </div>
                </div>

                <!-- Description & Details Section -->
                <div class="event-details-content-block">
                    <h2 class="content-block-heading">About This Event</h2>
                    <p class="content-block-paragraph">
                        @(string.IsNullOrWhiteSpace(Model?.Description) 
                            ? "An engaging session and workshop organized by ACM AMTICS to provide students with hands-on exposure to contemporary technologies, industry best practices, and collaborative peer learning." 
                            : Model.Description)
                    </p>
                    <p class="content-block-paragraph">
                        Participants gained direct practical insights, explored case studies, and engaged in real-time interactive Q&amp;A sessions guided by student leads and domain mentors.
                    </p>
                </div>

                <!-- Action Footer -->
                <div class="event-details-action-bar">
                    <a href="/Events" class="btn-outline-back">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        <span>Back to All Events</span>
                    </a>

                    @if (!isCompleted)
                    {
                        <a href="/Account/Login" class="btn-primary-purple" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem;">
                            <span>Register for Event</span>
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                    }
                    else if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Coordinator")))
                    {
                        <a href="/Events/@Model?.Id/Attendees" class="btn-primary-purple" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem;">
                            <span>View Attendees Management</span>
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                    }
                </div>
            </div>
        </article>

    </div>
</div>
