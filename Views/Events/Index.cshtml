@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Events & Attendance";
}

<!-- Page Header Row -->
<div class="page-header-row">
    <div class="header-titles">
        <h1 class="page-title">Events & Attendance</h1>
        <p class="page-subtitle">Manage events and view attendance statistics for ACM Amtics.</p>
    </div>
</div>

<!-- 2 Stat Cards Grid -->
<div class="stat-cards-grid-2">
    <!-- Card 1: Total Events -->
    <div class="stat-card">
        <div class="stat-card-left">
            <div class="stat-icon-wrapper">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </div>
            <div class="stat-label">Total Events</div>
            <div class="stat-value" id="statTotalEvents">18</div>
            <div class="stat-change-indicator">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
                <span id="statEventsChange">+20%</span>
                <span class="stat-change-text">from last semester</span>
            </div>
        </div>
        <!-- Trend Sparkline SVG -->
        <svg class="stat-card-sparkline" viewBox="0 0 100 50" preserveAspectRatio="none">
            <defs>
                <linearGradient id="gradEventSpark" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0.0"/>
                </linearGradient>
            </defs>
            <path d="M0,42 Q30,25 55,30 T95,12 L100,10 L100,50 L0,50 Z" fill="url(#gradEventSpark)"/>
            <path d="M0,42 Q30,25 55,30 T95,12 L100,10" fill="none" stroke="#8B5CF6" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
    </div>

    <!-- Card 2: Total Attendees -->
    <div class="stat-card">
        <div class="stat-card-left">
            <div class="stat-icon-wrapper">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-3.512M9 20H4v-2a3 3 0 015-3.512M12 11a4 4 0 100-8 4 4 0 000 8zm0 2a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <div class="stat-label">Total Attendees</div>
            <div class="stat-value" id="statTotalAttendees">860</div>
            <div class="stat-change-indicator">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
                <span id="statAttendeesChange">+16%</span>
                <span class="stat-change-text">from last semester</span>
            </div>
        </div>
        <!-- Trend Sparkline SVG -->
        <svg class="stat-card-sparkline" viewBox="0 0 100 50" preserveAspectRatio="none">
            <defs>
                <linearGradient id="gradAttendeeSpark" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0.0"/>
                </linearGradient>
            </defs>
            <path d="M0,45 Q25,35 48,22 T92,11 L100,9 L100,50 L0,50 Z" fill="url(#gradAttendeeSpark)"/>
            <path d="M0,45 Q25,35 48,22 T92,11 L100,9" fill="none" stroke="#8B5CF6" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
    </div>
</div>

<!-- All Events Section Card -->
<div class="card-section">
    <div class="card-section-header">
        <div class="header-left">
            <h2 class="section-title">All Events</h2>
            <p class="section-subtitle">View all events conducted by ACM Amtics and their attendance.</p>
        </div>
        <div class="section-actions">
            <!-- Search Input -->
            <div class="search-wrapper">
                <svg class="search-icon" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" id="eventSearchInput" class="search-input" placeholder="Search events..." autocomplete="off" />
            </div>

            <!-- Server-Side Enforced: + Add Event Button ONLY Exposed on /Events -->
            @if (ViewBag.ShowAddEventButton == true)
            {
                <button type="button" class="btn-primary" id="openAddEventModalBtn">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>Add Event</span>
                </button>
            }
        </div>
    </div>

    <!-- Events Table -->
    <div class="table-responsive">
        <table class="members-table">
            <thead>
                <tr>
                    <th class="col-num">#</th>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Attendees</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="eventsTableBody">
                <!-- Dynamically loaded via AJAX in admin-events.js -->
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    <div class="card-section-footer">
        <div class="pagination-info" id="eventPaginationInfo">
            Showing 1 to 8 of 18 events
        </div>
        <div class="pagination-controls" id="eventPaginationControls">
            <!-- Dynamically populated via AJAX in admin-events.js -->
        </div>
    </div>
</div>

<!-- ==========================================================================
     Page 2 — Add Event Modal
     ========================================================================== -->
<div class="modal-overlay" id="addEventModalOverlay" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="addEventModalTitle">
        <!-- Close Button -->
        <button type="button" class="modal-close-btn" id="closeAddEventModalBtn" aria-label="Close Modal">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <div class="modal-header">
            <h3 class="modal-title" id="addEventModalTitle">Add Event</h3>
            <p class="modal-subtitle">Create a new event for ACM Amtics.</p>
        </div>

        <form id="addEventForm" novalidate>
            <!-- Field 1: Event Name -->
            <div class="modal-form-group">
                <label class="modal-form-label" for="eventNameInput">Event Name</label>
                <div class="input-with-icon-wrapper">
                    <span class="input-left-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </span>
                    <input type="text" id="eventNameInput" name="name" class="modal-input" placeholder="Enter event name" required />
                </div>
                <div class="form-error-msg" id="eventNameError">Please enter a valid event name.</div>
            </div>

            <!-- Field 2: Date -->
            <div class="modal-form-group">
                <label class="modal-form-label" for="eventDateInput">Date</label>
                <div class="input-with-icon-wrapper">
                    <span class="input-left-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </span>
                    <input type="date" id="eventDateInput" name="date" class="modal-input" required />
                </div>
                <div class="form-error-msg" id="eventDateError">Please select a valid event date.</div>
            </div>

            <!-- Field 3: Time -->
            <div class="modal-form-group">
                <label class="modal-form-label" for="eventTimeInput">Time</label>
                <div class="input-with-icon-wrapper">
                    <span class="input-left-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </span>
                    <select id="eventTimeInput" name="time" class="modal-select" required>
                        <option value="" disabled selected>Select time</option>
                        <option value="10:00 AM - 1:00 PM">10:00 AM - 1:00 PM</option>
                        <option value="11:00 AM - 1:30 PM">11:00 AM - 1:30 PM</option>
                        <option value="02:00 PM - 04:30 PM">02:00 PM - 04:30 PM</option>
                        <option value="03:00 PM - 05:00 PM">03:00 PM - 05:00 PM</option>
                        <option value="09:00 AM - 09:00 PM">09:00 AM - 09:00 PM</option>
                        <option value="10:30 AM - 01:30 PM">10:30 AM - 01:30 PM</option>
                    </select>
                    <svg class="select-right-chevron" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
                <div class="form-error-msg" id="eventTimeError">Please select or provide event time.</div>
            </div>

            <!-- Field 4: Venue -->
            <div class="modal-form-group">
                <label class="modal-form-label" for="eventVenueInput">Venue</label>
                <div class="input-with-icon-wrapper">
                    <span class="input-left-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </span>
                    <input type="text" id="eventVenueInput" name="venue" class="modal-input" placeholder="Enter venue (e.g. Seminar Hall, AMTICS)" required />
                </div>
                <div class="form-error-msg" id="eventVenueError">Please specify the event venue.</div>
            </div>

            <!-- Field 5: Category -->
            <div class="modal-form-group">
                <label class="modal-form-label" for="eventCategoryInput">Category</label>
                <div class="input-with-icon-wrapper">
                    <span class="input-left-icon">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
                        </svg>
                    </span>
                    <select id="eventCategoryInput" name="category" class="modal-select" required>
                        <option value="" disabled selected>Enter category (e.g. Workshop, Seminar, Talk)</option>
                        <option value="Workshop">Workshop</option>
                        <option value="Seminar">Seminar</option>
                        <option value="Competition">Competition</option>
                        <option value="Talk">Talk</option>
                    </select>
                    <svg class="select-right-chevron" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
                <div class="form-error-msg" id="eventCategoryError">Please choose an event category.</div>
            </div>

            <!-- Footer Buttons -->
            <div class="modal-footer">
                <button type="button" class="btn-secondary" id="cancelAddEventBtn">Cancel</button>
                <button type="submit" class="modal-btn-submit" id="submitAddEventBtn">Add Event</button>
            </div>
        </form>
    </div>
</div>

<!-- ==========================================================================
     QR Scan Modal (for Active / Today Events)
     ========================================================================== -->
<div class="modal-overlay" id="qrModalOverlay" aria-hidden="true">
    <div class="modal-card" style="max-width: 420px; text-align: center;" role="dialog" aria-modal="true">
        <button type="button" class="modal-close-btn" id="closeQrModalBtn" aria-label="Close QR Modal">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <div style="margin-bottom: 1.5rem;">
            <h3 class="modal-title" id="qrEventTitle">Event Check-In QR</h3>
            <p class="modal-subtitle">Scan to record attendee presence in real-time.</p>
        </div>
        <div style="padding: 1.5rem; background: #FAF5FF; border-radius: 12px; display: inline-block; margin-bottom: 1.25rem;">
            <svg width="180" height="180" viewBox="0 0 24 24" fill="none" stroke="#6D28D9" stroke-width="1.5">
                <rect x="2" y="2" width="8" height="8" rx="2" />
                <rect x="4" y="4" width="4" height="4" fill="#6D28D9" />
                <rect x="14" y="2" width="8" height="8" rx="2" />
                <rect x="16" y="4" width="4" height="4" fill="#6D28D9" />
                <rect x="2" y="14" width="8" height="8" rx="2" />
                <rect x="4" y="16" width="4" height="4" fill="#6D28D9" />
                <path d="M14 14h2v2h-2zM18 14h2v2h-2zM14 18h2v2h-2zM18 18h4v4h-4z" fill="#6D28D9" />
            </svg>
        </div>
        <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 1.5rem;">
            Students can scan using the ACM AMTICS Student Portal to mark attendance.
        </p>
        <button type="button" class="btn-primary" style="width: 100%; justify-content: center;" id="dismissQrModalBtn">
            Close Scanner
        </button>
    </div>
</div>

<!-- Toast Notification Container -->
<div class="toast-container" id="toastContainer" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/admin-events.js" asp-append-version="true"></script>
}
