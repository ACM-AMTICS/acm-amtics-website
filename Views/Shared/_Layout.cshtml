<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ACM AMTICS</title>
    <!-- Fonts: Inter & Plus Jakarta Sans & Caveat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Background Ambient Glow & Circular Rings -->
    <div class="bg-decorations" aria-hidden="true">
        <div class="ambient-glow glow-top-left"></div>
        <div class="ambient-glow glow-top-right"></div>
        <div class="decor-circle-top-left"></div>
        <div class="decor-ring-top-left"></div>
    </div>

    <!-- Header Navbar -->
    <header class="site-header" id="siteHeader">
        <div class="header-container">
            <!-- Brand Logo & Chapter Identity -->
            <a asp-controller="Home" asp-action="Index" class="brand-logo-link">
                <img src="~/images/acm-logo.svg" alt="ACM AMTICS Logo" class="acm-logo-img" />
                <div class="brand-text-block">
                    <span class="brand-title">ACM AMTICS</span>
                    <span class="brand-subtitle">Student Chapter</span>
                </div>
            </a>

            <!-- Mobile Nav Toggle -->
            <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle Navigation" aria-expanded="false" aria-controls="navMenu">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>

            <!-- Navigation Links Pill Menu -->
            <nav class="nav-menu-wrapper" id="navMenu">
                <ul class="nav-menu">
                    <li><a href="/" class="nav-link-item @(ViewBag.ActiveMenu == "Home" || ViewBag.ActiveMenu == null ? "active" : "")">Home</a></li>
                    <li><a href="/Events" class="nav-link-item @(ViewBag.ActiveMenu == "Events" ? "active" : "")">Events</a></li>
                    <li><a href="/Projects" class="nav-link-item @(ViewBag.ActiveMenu == "Projects" ? "active" : "")">Projects</a></li>
                    <li><a href="/#gallery" class="nav-link-item @(ViewBag.ActiveMenu == "Gallery" ? "active" : "")">Gallery</a></li>
                    <li><a href="/#about" class="nav-link-item @(ViewBag.ActiveMenu == "Heads" ? "active" : "")">Heads</a></li>
                    <li><a href="/#why-join" class="nav-link-item @(ViewBag.ActiveMenu == "Contributors" ? "active" : "")">Contributors</a></li>
                </ul>
            </nav>

            <!-- Right Actions: Search + CTA -->
            <div class="header-actions">
                <button class="header-search-btn" aria-label="Search">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </button>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn-primary-purple">
                        <span>Dashboard</span>
                        <svg class="btn-arrow-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-primary-purple" id="headerJoinBtn">
                        <span>Login</span>
                        <svg class="btn-arrow-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="main-wrapper-landing" id="mainContent">
        @RenderBody()
    </main>

    <!-- Dark Navy Midnight Footer -->
    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-top-grid">
                <!-- Col 1: Brand & Chapter Info -->
                <div class="footer-col-brand">
                    <div class="footer-logo-row">
                        <img src="~/images/acm-logo.svg" alt="ACM AMTICS" class="footer-logo-img" />
                        <div class="footer-brand-text">
                            <span class="footer-brand-title">ACM AMTICS</span>
                            <span class="footer-brand-subtitle">Student Chapter</span>
                        </div>
                    </div>
                    <p class="footer-description">
                        The official student chapter of the Association for Computing Machinery at the Department of Computer Science & Engineering, AMTICS.
                    </p>
                    <div class="footer-social-icons">
                        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="Instagram">
                            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                        </a>
                        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="LinkedIn">
                            <svg viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                        </a>
                        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="GitHub">
                            <svg viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                        </a>
                        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="YouTube">
                            <svg viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                        </a>
                    </div>
                </div>

                <!-- Col 2: Explore -->
                <div class="footer-col-nav">
                    <h4 class="footer-col-heading">Explore</h4>
                    <ul class="footer-links-list">
                        <li><a href="/">Home</a></li>
                        <li><a href="/Events">Events</a></li>
                        <li><a href="/Projects">Projects</a></li>
                        <li><a href="/#gallery">Gallery</a></li>
                        <li><a href="/#about">Heads</a></li>
                        <li><a href="/#why-join">Contributors</a></li>
                    </ul>
                </div>

                <!-- Col 3: Community -->
                <div class="footer-col-nav">
                    <h4 class="footer-col-heading">Community</h4>
                    <ul class="footer-links-list">
                        <li><a asp-controller="Account" asp-action="Login">Join Us</a></li>
                        <li><a href="/#about">Our Team</a></li>
                        <li><a href="/#why-join">Become a Member</a></li>
                        <li><a href="/Events">Events</a></li>
                        <li><a href="/Projects">Projects</a></li>
                        <li><a href="mailto:acm@amtics.edu.in">Contact</a></li>
                    </ul>
                </div>

                <!-- Col 4: Resources -->
                <div class="footer-col-nav">
                    <h4 class="footer-col-heading">Resources</h4>
                    <ul class="footer-links-list">
                        <li><a href="https://www.acm.org" target="_blank" rel="noopener noreferrer">ACM Global</a></li>
                        <li><a href="#about">Student Resources</a></li>
                        <li><a href="#about">Code of Conduct</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Terms &amp; Conditions</a></li>
                    </ul>
                </div>
            </div>

            <!-- Footer Bottom Subbar -->
            <div class="footer-bottom-bar">
                <span class="footer-copyright">&copy; 2025 ACM AMTICS. All rights reserved.</span>
                <span class="footer-tagline">Build. Collaborate. Inspire.</span>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("mobileNavToggle");
            const navMenu = document.getElementById("navMenu");

            if (toggleBtn && navMenu) {
                toggleBtn.addEventListener("click", function () {
                    const expanded = toggleBtn.getAttribute("aria-expanded") === "true";
                    toggleBtn.setAttribute("aria-expanded", !expanded);
                    navMenu.classList.toggle("open");
                });

                // Auto close menu when a nav link is clicked on mobile
                navMenu.querySelectorAll("a").forEach(function(link) {
                    link.addEventListener("click", function() {
                        navMenu.classList.remove("open");
                        toggleBtn.setAttribute("aria-expanded", "false");
                    });
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
