@{
    var currentUserName = User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.Identity.Name) 
        ? User.Identity.Name 
        : "Admin";
    var currentUserEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "adminauth@gmail.com";
    var currentUserRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
        ?? (currentUserEmail.Contains("hetvi022", StringComparison.OrdinalIgnoreCase) || currentUserEmail.Contains("coord", StringComparison.OrdinalIgnoreCase) || currentUserEmail.Contains("yahiya", StringComparison.OrdinalIgnoreCase) ? "Coordinator" : "Admin");
    var isCoordinator = currentUserRole.Equals("Coordinator", StringComparison.OrdinalIgnoreCase);
    var isAdmin = !isCoordinator;
    var currentUserInitial = !string.IsNullOrWhiteSpace(currentUserName) ? currentUserName.Substring(0, 1).ToUpper() : (isCoordinator ? "H" : "A");
    var assignedEventName = User.FindFirst("AssignedEventName")?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ACM AMTICS Admin Panel</title>
    <!-- Google Fonts: Inter & Caveat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Admin & Profile Stylesheets -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <!-- Layout Wrapper -->
    <div class="admin-layout">
        <!-- Sidebar Backdrop for Mobile -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Brand / Logo -->
            <div class="sidebar-brand">
                <a href="@(isCoordinator ? "/Events/Manage" : "/Dashboard")" class="brand-link">
                    <img src="~/images/acm-logo.svg" alt="ACM Amtics Logo" class="brand-logo-img" />
                    <div class="brand-text-group">
                        <span class="brand-title">ACM AMTICS</span>
                        <span class="brand-subtitle">Student Chapter</span>
                    </div>
                </a>
            </div>

            <!-- Navigation Links (Matching Screenshot) -->
            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <!-- Dashboard -->
                    <li class="nav-item">
                        <a href="/Dashboard" class="nav-link @(ViewBag.ActiveMenu == "Dashboard" ? "active" : "")">
                            <span class="nav-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                                </svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </a>
                    </li>
                    <!-- Events & Workshops -->
                    <li class="nav-item">
                        <a href="/Events/Manage" class="nav-link @(ViewBag.ActiveMenu == "Events" ? "active" : "")">
                            <span class="nav-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </span>
                            <span class="nav-label">Events & Workshops</span>
                        </a>
                    </li>
                    <!-- Projects -->
                    <li class="nav-item">
                        <a href="/Projects" class="nav-link @(ViewBag.ActiveMenu == "Projects" ? "active" : "")">
                            <span class="nav-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                                </svg>
                            </span>
                            <span class="nav-label">Projects</span>
                        </a>
                    </li>
                    <!-- Gallery -->
                    <li class="nav-item">
                        <a href="/Gallery" class="nav-link @(ViewBag.ActiveMenu == "Gallery" ? "active" : "")">
                            <span class="nav-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </span>
                            <span class="nav-label">Gallery</span>
                        </a>
                    </li>
                    <!-- Teams -->
                    <li class="nav-item">
                        <a href="/Members" class="nav-link @(ViewBag.ActiveMenu == "Members" || ViewBag.ActiveMenu == "Teams" ? "active" : "")">
                            <span class="nav-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-3.512M9 20H4v-2a3 3 0 015-3.512M12 11a4 4 0 100-8 4 4 0 000 8zm0 2a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </span>
                            <span class="nav-label">Teams</span>
                        </a>
                    </li>
                    <!-- Profile -->
                    <li class="nav-item">
                        <a href="/Profile" class="nav-link @(ViewBag.ActiveMenu == "Profile" ? "active" : "")">
                            <span class="nav-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </span>
                            <span class="nav-label">Profile</span>
                        </a>
                    </li>
                    <!-- Submit Project -->
                    <li class="nav-item">
                        <a href="/Projects?submit=true" class="nav-link @(ViewBag.ActiveMenu == "SubmitProject" ? "active" : "")">
                            <span class="nav-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                            </span>
                            <span class="nav-label">Submit Project</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-main">
            <!-- Top Navbar (Matching Screenshot) -->
            <header class="admin-topbar">
                <div class="topbar-left" style="display:flex; align-items:center; gap:1.25rem;">
                    <button class="mobile-menu-btn" id="mobileMenuToggle" aria-label="Toggle Navigation">
                        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                    <!-- Global Search input -->
                    <div class="topbar-search-box">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#9CA3AF">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" id="globalTopSearch" class="topbar-search-input" placeholder="Search events, projects, members..." autocomplete="off" />
                    </div>
                </div>

                <div class="topbar-right" style="display:flex; align-items:center; gap:1.25rem;">
                    <!-- Notification Bell -->
                    <button class="topbar-bell-btn" title="1 New Notification" onclick="alert('Notification: You earned the Event Enthusiast badge! 🎉')">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                        <span class="bell-badge">1</span>
                    </button>

                    <!-- Profile Dropdown -->
                    <div class="profile-dropdown-wrapper" id="profileDropdownWrapper">
                        <button class="profile-btn" id="profileDropdownBtn" aria-expanded="false" aria-label="User Menu" style="display:flex; align-items:center; gap:0.75rem; padding:0.35rem 0.65rem; border-radius:9999px; background:#F8FAFC; border:1px solid #E2E8F0;">
                            <img src="/images/avatars/ayesha-khan.jpg" alt="Ayesha Khan" class="topbar-avatar-img user-header-avatar" onerror="this.src='/images/avatars/avatar-1.jpg'" />
                            <div class="topbar-user-info">
                                <span class="profile-name user-header-name" style="font-size:0.875rem; font-weight:700; color:#111827;">Ayesha Khan</span>
                                <span class="profile-subtext user-header-sub" style="font-size:0.7rem; color:#6B7280;">3rd Year • CSE</span>
                            </div>
                            <svg class="chevron-icon" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#6B7280">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>

                        <!-- Dropdown Menu -->
                        <div class="profile-dropdown-menu" id="profileDropdownMenu">
                            <div class="dropdown-header">
                                <div class="dropdown-user-name user-header-name">Ayesha Khan</div>
                                <div class="dropdown-user-email">ayesha.k@amtics.ac.in</div>
                                <div class="dropdown-user-badge-role">
                                    <span class="role-pill-badge role-coord-badge">
                                        Active Member
                                    </span>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="/Profile" class="dropdown-item">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                <span>My Profile</span>
                            </a>
                            <a href="/MemberProfile" class="dropdown-item">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                                <span>View Public Member Profile</span>
                            </a>
                            <a href="javascript:void(0)" onclick="if(window.openEventTicketModal) window.openEventTicketModal();" class="dropdown-item">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                                </svg>
                                <span>My Event Ticket</span>
                            </a>
                            <a href="/Dashboard" class="dropdown-item">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                                <span>Admin Dashboard</span>
                            </a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item logout-item">
                                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                    <span>Sign Out</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Body Content -->
            <main class="admin-content-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Member Modal (Global: Add & Edit Member) -->
    <div class="modal-backdrop" id="addMemberModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="modal-container">
            <!-- Close Button -->
            <button type="button" class="modal-close-btn" id="closeModalBtn" aria-label="Close Modal">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <!-- Modal Header -->
            <div class="modal-header">
                <h3 class="modal-title" id="modalTitle">Add Member</h3>
                <p class="modal-subtitle" id="modalSubtitle">Add a new member to ACM Amtics.</p>
            </div>

            <!-- Modal Form -->
            <form id="addMemberForm" novalidate>
                <input type="hidden" id="editingMemberId" value="" />

                <!-- Name Field -->
                <div class="modal-form-group">
                    <label class="modal-form-label" for="memberName">Name</label>
                    <div class="input-with-icon-wrapper">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </span>
                        <input type="text" id="memberName" class="modal-input" placeholder="Enter full name" required />
                    </div>
                    <div class="form-error-msg" id="memberNameError"></div>
                </div>

                <!-- Email Address Field -->
                <div class="modal-form-group">
                    <label class="modal-form-label" for="memberEmail">Email Address</label>
                    <div class="input-with-icon-wrapper">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </span>
                        <input type="email" id="memberEmail" class="modal-input" placeholder="Enter email address" required />
                    </div>
                    <div class="form-error-msg" id="memberEmailError"></div>
                </div>

                <!-- Phone Number Field with Country Code -->
                <div class="modal-form-group">
                    <label class="modal-form-label" for="memberPhone">Phone Number</label>
                    <div class="phone-input-combined">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                        </span>
                        <input type="tel" id="memberPhone" class="phone-input-field" placeholder="Enter phone number" required />
                        <select id="memberCountryCode" class="country-code-select" aria-label="Country Code">
                            <option value="+91" selected>+91</option>
                            <option value="+1">+1</option>
                            <option value="+44">+44</option>
                            <option value="+61">+61</option>
                        </select>
                    </div>
                    <div class="form-error-msg" id="memberPhoneError"></div>
                </div>

                <!-- Enrollment Number Field -->
                <div class="modal-form-group">
                    <label class="modal-form-label" for="memberEnrollment">Enrollment Number</label>
                    <div class="input-with-icon-wrapper">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
                            </svg>
                        </span>
                        <input type="text" id="memberEnrollment" class="modal-input" placeholder="Enter enrollment number" required />
                    </div>
                    <div class="form-error-msg" id="memberEnrollmentError"></div>
                </div>

                <!-- Role Field -->
                <div class="modal-form-group">
                    <label class="modal-form-label" for="memberRole">Role</label>
                    <div class="input-with-icon-wrapper">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5-3.512M9 20H4v-2a3 3 0 015-3.512M12 11a4 4 0 100-8 4 4 0 000 8zm0 2a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </span>
                        <select id="memberRole" class="modal-select" required>
                            <option value="Member" selected>Member</option>
                            <option value="Coordinator">Coordinator</option>
                            <option value="Event Head">Event Head</option>
                            <option value="Technical Head">Technical Head</option>
                            <option value="Vice President">Vice President</option>
                            <option value="President">President</option>
                        </select>
                        <span class="select-right-chevron">
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </div>
                    <div class="form-error-msg" id="memberRoleError"></div>
                </div>

                <!-- Conditional Dynamic Field: Assign Event -->
                <div class="dynamic-field-container" id="dynamicEventGroup">
                    <label class="modal-form-label" for="assignEventSelect">Assign Event</label>
                    <div class="input-with-icon-wrapper">
                        <span class="input-left-icon">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </span>
                        <select id="assignEventSelect" class="modal-select">
                            <option value="">Select an Event</option>
                            <!-- Dynamically loaded via /api/events -->
                        </select>
                        <span class="select-right-chevron">
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </div>
                </div>

                <!-- Footer Buttons -->
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" id="cancelModalBtn">Cancel</button>
                    <button type="submit" class="modal-btn-submit" id="submitAddMemberBtn">Add Member</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toastNotification" class="toast-container" aria-live="polite">
        <div class="toast-card" id="toastCard">
            <span class="toast-icon" id="toastIcon"></span>
            <div class="toast-message" id="toastMessage"></div>
        </div>
    </div>

    <!-- Global Layout Scripts -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Profile dropdown toggle
            const profileBtn = document.getElementById("profileDropdownBtn");
            const profileMenu = document.getElementById("profileDropdownMenu");

            if (profileBtn && profileMenu) {
                profileBtn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    const isOpen = profileMenu.classList.contains("show");
                    if (isOpen) {
                        profileMenu.classList.remove("show");
                        profileBtn.setAttribute("aria-expanded", "false");
                    } else {
                        profileMenu.classList.add("show");
                        profileBtn.setAttribute("aria-expanded", "true");
                    }
                });

                document.addEventListener("click", function (e) {
                    if (!profileBtn.contains(e.target) && !profileMenu.contains(e.target)) {
                        profileMenu.classList.remove("show");
                        profileBtn.setAttribute("aria-expanded", "false");
                    }
                });
            }

            // Mobile menu toggle
            const mobileToggle = document.getElementById("mobileMenuToggle");
            const sidebar = document.getElementById("adminSidebar");
            const backdrop = document.getElementById("sidebarBackdrop");

            if (mobileToggle && sidebar && backdrop) {
                mobileToggle.addEventListener("click", function () {
                    sidebar.classList.toggle("open");
                    backdrop.classList.toggle("open");
                });

                backdrop.addEventListener("click", function () {
                    sidebar.classList.remove("open");
                    backdrop.classList.remove("open");
                });
            }
        });

        // Global Toast helper
        window.showToast = function (message, type = 'success') {
            const toast = document.getElementById("toastNotification");
            const card = document.getElementById("toastCard");
            const icon = document.getElementById("toastIcon");
            const text = document.getElementById("toastMessage");

            if (!toast || !card) return;

            card.className = "toast-card " + (type === 'error' ? 'toast-error' : 'toast-success');
            icon.innerHTML = type === 'error' ? '&#10006;' : '&#10004;';
            text.textContent = message;

            toast.classList.add("visible");
            setTimeout(() => {
                toast.classList.remove("visible");
            }, 3500);
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
