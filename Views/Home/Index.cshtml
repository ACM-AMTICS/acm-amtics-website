                    </div>
                    <span class="community-text" id="hero-community-text">Join 500+ students growing with ACM AMTICS</span>
                </div>
            </div>

            <!-- Right Hero Illustration Graphic -->
            <div class="hero-illustration">
                <div class="hero-graphic-card">
                    <div class="graphic-circle-outer">
                        <div class="graphic-circle-inner">
                            <img src="~/images/acm-logo.svg" alt="ACM AMTICS Logo" class="graphic-logo" />
                        </div>
                        <!-- Orbiting Icon Floating Badges -->
                        <div class="orbit-badge badge-top-left">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
