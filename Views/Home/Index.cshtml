    <!-- RECENT EVENTS SECTION -->
    <section class="section-wrapper events-section" id="events">
        <div class="section-container">
            <div class="section-header-row">
                <div>
                    <span class="section-tag" id="events-tag">EVENTS</span>
                    <h2 class="section-title" id="events-title">Recent Events</h2>
                    <p class="section-subtitle" id="events-subtitle">A glimpse of our latest workshops, talks and community initiatives.</p>
                </div>
                <a href="javascript:void(0);" class="link-arrow" id="events-link">
                    <span>View All Events</span>
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
