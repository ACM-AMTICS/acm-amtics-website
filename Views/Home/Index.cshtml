        <div class="section-container">
            <div class="section-header-row">
                <div>
                    <span class="section-tag" id="projects-tag">PROJECTS</span>
                    <h2 class="section-title" id="projects-title">Student Projects</h2>
                    <p class="section-subtitle" id="projects-subtitle">Innovative projects built by our talented community members.</p>
                </div>
                <a href="javascript:void(0);" class="link-arrow" id="projects-link">
                    <span>View All Projects</span>
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
            </div>

            <div class="projects-grid" id="projects-grid-container">
                <!-- Dynamically Populated from homeData.json -->
            </div>
        </div>
    </section>

    <!-- WHY JOIN ACM AMTICS SECTION -->
    <section class="section-wrapper why-join-section">
        <div class="section-container">
            <div class="section-header-row">
                <div>
                    <span class="section-tag" id="whyjoin-tag">COMMUNITY</span>
                    <h2 class="section-title" id="whyjoin-title">Why Join ACM AMTICS?</h2>
                </div>
            </div>

            <div class="why-join-grid">
                <!-- Left Banner Image with Floating Badge -->
                <div class="why-join-image-wrapper">
                    <div class="why-join-img-container" id="whyjoin-img-container">
                        <!-- Image rendered dynamically or fallback styled box -->
                    </div>
                    <div class="why-join-floating-badge">
                        <div class="badge-title" id="whyjoin-badge-title">More than a</div>
                        <div class="badge-sub" id="whyjoin-badge-sub">student chapter</div>
                        <div class="badge-caption">A growing community</div>
                        <button class="btn-circle-arrow" aria-label="Join Community">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </button>
                    </div>
                </div>

                <!-- Right Benefits List -->
                <div class="why-join-right">
                    <p class="why-join-desc" id="whyjoin-desc">
                        Be a part of a vibrant community of learners, builders and changemakers. ACM AMTICS gives you the platform, people and opportunities to grow beyond the classroom.
                    </p>

                    <div class="benefits-list" id="benefits-list-container">
                        <div class="benefit-item">
                            <div class="benefit-icon-box icon-purple">
                                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/></svg>
                            </div>
                            <div>
