@{
    ViewData["Title"] = "Home - ACM AMTICS Student Chapter";
}

<div class="landing-page-container">
    <!-- HERO SECTION -->
    <section class="hero-section" id="hero">
        <div class="hero-container">
            <!-- Left Hero Content -->
            <div class="hero-content">
                <div class="hero-badge" id="hero-badge">
                    <span class="badge-dot"></span>
                    <span id="hero-badge-text">Association for Computing Machinery</span>
                </div>

                <h1 class="hero-title">
                    <span id="hero-title-line1">Build. Collaborate.</span><br />
                    <span class="text-primary-solid" id="hero-title-line2">Inspire.</span>
                </h1>

                <h2 class="hero-subtitle" id="hero-subtitle">ACM AMTICS Student Chapter</h2>

                <p class="hero-description" id="hero-description">
                    A community of learners, builders, and changemakers from the Department of Computer Science & Engineering, AMTICS. We organize events, workshops, projects and initiatives to explore, learn and grow together.
                </p>

                <div class="hero-actions">
                    <a href="#events" class="btn-primary-solid" id="hero-btn-events">
                        <span>Explore Events</span>
                        <svg class="btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                    <a href="#about" class="btn-secondary-solid" id="hero-btn-learn">Learn More</a>
                </div>

                <div class="hero-community-bar">
                    <div class="avatar-stack">
                        <div class="avatar-circle">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                        </div>
                        <div class="avatar-circle">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                        </div>
                        <div class="avatar-circle">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
