    <!-- ABOUT SECTION -->
    <section class="section-wrapper about-section" id="about">
        <div class="section-container">
            <div class="about-grid">
                <div class="about-left">
                    <span class="section-tag" id="about-tag">ABOUT US</span>
                    <h2 class="section-title" id="about-title">About ACM AMTICS</h2>
                    <p class="section-description" id="about-description">
                        ACM AMTICS is the official student chapter of the Association for Computing Machinery at the Department of Computer Science & Engineering, AMTICS. We aim to create a platform for students to learn, build, collaborate and make a positive impact through technology and innovation.
                    </p>
                    <a href="javascript:void(0);" class="btn-outline-solid" id="about-btn">
                        <span>Our Journey</span>
                        <svg class="btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </a>
                </div>

                <div class="about-features-grid" id="about-features-container">
                    <div class="feature-box">
                        <div class="feature-icon-box icon-blue">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
                        </div>
                        <div class="feature-content">
                            <h3 class="feature-title">Learn</h3>
                            <p class="feature-desc">Workshops, talks and knowledge sharing</p>
                        </div>
                    </div>
                    <div class="feature-box">
                        <div class="feature-icon-box icon-purple">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        </div>
                        <div class="feature-content">
                            <h3 class="feature-title">Collaborate</h3>
                            <p class="feature-desc">Work with peers, faculty and industry experts</p>
                        </div>
                    </div>
                    <div class="feature-box">
                        <div class="feature-icon-box icon-orange">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                        </div>
                        <div class="feature-content">
                            <h3 class="feature-title">Build</h3>
                            <p class="feature-desc">Projects, hackathons and real-world solutions</p>
                        </div>
                    </div>
                    <div class="feature-box">
                        <div class="feature-icon-box icon-green">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
                        </div>
                        <div class="feature-content">
                            <h3 class="feature-title">Create Impact</h3>
                            <p class="feature-desc">Use technology for a better tomorrow</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- WHAT WE DO / OUR FOCUS -->
    <section class="section-wrapper focus-section">
        <div class="section-container">
            <div class="section-header-row">
                <div>
                    <span class="section-tag" id="focus-tag">OUR FOCUS</span>
                    <h2 class="section-title" id="focus-title">What We Do</h2>
                </div>
                <a href="javascript:void(0);" class="link-arrow" id="focus-link">
                    <span>Learn More</span>
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
