@model acm_amtics_website.Models.GalleryViewModel
@{
    ViewData["Title"] = "Gallery";
}
<link rel="stylesheet" href="~/css/showcase.css" asp-append-version="true" />

<section class="showcase-page gallery-page">
    <div class="showcase-hero gallery-hero">
        <div class="hero-text-content">
            <div class="crumb">
                <a href="/">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    Home
                </a>
                <span class="crumb-separator">/</span>
                <span>Gallery</span>
            </div>
            <h1>Photo <em>Gallery</em></h1>
            <h2>Moments that inspire</h2>
            <p>A glimpse into our events, workshops, hackathons, and community initiatives. Relive the memories and celebrate the vibrant tech journey of ACM AMTICS.</p>
        </div>
        <div class="hero-art gallery-art" aria-hidden="true">
            <span>
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </span>
            <small>People<br/>Events<br/>Learning<br/>Community<br/>Memories</small>
        </div>
    </div>

    <div class="gallery-toolbar">
        <div class="category-pills" id="galleryCategories" role="tablist" aria-label="Gallery categories">
            @foreach (var cat in Model.Categories)
            {
                <button class="pill-btn @(cat == "All" ? "selected" : "")" data-category="@cat" role="tab" aria-selected="@(cat == "All" ? "true" : "false")">
                    @cat
                </button>
            }
        </div>
        <div class="gallery-controls">
            <div class="search-field">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input id="gallerySearch" type="search" placeholder="Search albums, talks, workshops..." aria-label="Search gallery" />
            </div>
            <div class="select-field">
                <select id="gallerySort" aria-label="Sort albums by date">
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Active Filter & Count Status Bar -->
    <div class="gallery-status-bar">
        <span class="gallery-counter" id="galleryCounter">Showing all albums</span>
        <button type="button" class="clear-filters-btn" id="galleryClearBtn" style="display: none;">Reset Filters</button>
    </div>

    <div class="gallery-layout">
        <!-- Main Albums Grid -->
        <main class="gallery-main-content">
            <div class="gallery-grid" id="galleryGrid">
                @foreach (var g in Model.Items)
                {
                    var parsedDate = DateTime.TryParse(g.Date, out var dt) ? dt.ToString("yyyy-MM-dd") : g.Date;
                    var imageUrl = $"https://images.unsplash.com/{g.Image}?auto=format&fit=crop&w=900&q=80";
                    <article class="gallery-card" data-category="@g.Category" data-title="@g.Title" data-date="@parsedDate" tabindex="0">
                        <div class="gallery-photo">
                            <img src="@imageUrl" alt="@g.Title" loading="lazy" />
                            <div class="photo-overlay"></div>
                            <span class="photo-count" title="@g.Count photos in album">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m3 9 18 0"/><path d="m9 21 0-12"/></svg>
                                @g.Count photos
                            </span>
                        </div>
                        <div class="gallery-info">
                            <div class="gallery-meta-row">
                                <span class="tag">@g.Category</span>
                                <time class="date-chip" datetime="@parsedDate">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                                    @g.DisplayDate
                                </time>
                            </div>
                            <h3 class="gallery-title" title="@g.Title">@g.Title</h3>
                            <button type="button" class="gallery-view-btn" aria-label="View @g.Title album" title="View Album">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </button>
                        </div>
                    </article>
                }
            </div>

            <!-- Empty state when no matches -->
            <div class="gallery-empty-state" id="galleryEmptyState" style="display: none;">
                <div class="empty-icon-box">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                </div>
                <h3>No photo albums found</h3>
                <p>Try modifying your search or select a different category to view more moments.</p>
                <button type="button" class="pill-btn selected" id="galleryResetEmptyBtn">Show All Albums</button>
            </div>
        </main>

        <!-- Highlights & Short Reels Sidebar Rail -->
        <aside class="reels-rail" aria-label="Event Highlights & Reels">
            <div class="reels-rail-header">
                <div class="reels-title-wrap">
                    <span class="reels-badge-pulse"></span>
                    <h3 class="reels-heading">Event Highlights</h3>
                </div>
                <span class="reels-caption">Short Reels</span>
            </div>
            
            <div class="reels-cards-container">
                @foreach (var r in Model.Reels)
                {
                    <a class="reel-card" href="@r.Url" aria-label="@r.AriaLabel">
                        <img src="@r.Img" alt="@r.ImgAlt" loading="lazy" />
                        <div class="reel-scrim"></div>
                        <div class="reel-top-bar">
                            <span class="reel-label">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                Reel
                            </span>
                            <span class="reel-play" aria-hidden="true">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                            </span>
                        </div>
                        <div class="reel-bottom-bar">
                            <span class="reel-duration">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                @r.Duration
                            </span>
                            <strong class="reel-title">@Html.Raw(r.Title.Replace("Highlights from", "Highlights from<br/>"))</strong>
                        </div>
                        <span class="reel-arrow" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </span>
                    </a>
                }
            </div>
        </aside>
    </div>

    <!-- Lightbox Modal for previewing images -->
    <div class="gallery-lightbox" id="galleryLightbox" role="dialog" aria-modal="true" aria-label="Photo preview" style="display: none;">
        <div class="lightbox-backdrop" id="lightboxBackdrop"></div>
        <div class="lightbox-dialog">
            <button class="lightbox-close" id="lightboxClose" aria-label="Close modal">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <div class="lightbox-media-wrap">
                <img id="lightboxImg" src="" alt="Album photo" />
            </div>
            <div class="lightbox-details">
                <span class="tag" id="lightboxTag">Category</span>
                <h3 id="lightboxTitle">Album Title</h3>
                <span class="date-chip" id="lightboxDate">Date</span>
            </div>
        </div>
    </div>
</section>

<script src="~/js/showcase.js" asp-append-version="true"></script>