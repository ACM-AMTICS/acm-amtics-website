@{ ViewData["Title"] = "Gallery"; }
<link rel="stylesheet" href="~/css/showcase.css" asp-append-version="true" />
<section class="showcase-page">
<div class="showcase-hero gallery-hero"><div><div class="crumb"><a href="/">⌂ Home</a><span>›</span> Gallery</div><h1><em>Gallery</em></h1><h2>Moments that inspire</h2><p>A glimpse into our events, workshops, hackathons and community initiatives. Relive the memories and see the vibrant journey of ACM AMTICS.</p></div><div class="hero-art gallery-art"><span>◎</span><small>People<br/>Events<br/>Learning<br/>Community<br/>Memories</small></div></div>
<div class="gallery-toolbar"><div class="category-pills" id="galleryCategories"><button class="selected" data-category="All">All</button><button data-category="Events">♧ Events</button><button data-category="Workshops">♧ Workshops</button><button data-category="Hackathons">♧ Hackathons</button><button data-category="Talks">▣ Talks & Seminars</button><button data-category="Competitions">♜ Competitions</button><button data-category="Community">♧ Community</button></div><label class="search-field"><input id="gallerySearch" placeholder="⌕ Search photos, events or tags..." /></label><select id="gallerySort"><option>Newest First</option><option>Oldest First</option></select></div>
@{ var gallery = new[] {
new {Title="UI/UX Design Workshop",Cat="Workshops",Date="14 Dec 2024",Count="24",Img="photo-1516321318423-f06f85e504b3"},new {Title="ACM Hackathon 2024",Cat="Hackathons",Date="10 Oct 2024",Count="36",Img="photo-1522071820081-009f0129c71c"},new {Title="Introduction to AI/ML",Cat="Talks",Date="25 Sep 2024",Count="28",Img="photo-1475721027785-f74eccf877e2"},new {Title="Tech for Social Good",Cat="Talks",Date="18 Sep 2024",Count="42",Img="photo-1511632765486-a01980e01a18"},new {Title="Open Source and GSoC Session",Cat="Talks",Date="2 Aug 2024",Count="21",Img="photo-1519389950473-47ba0277781c"},new {Title="Flutter Development Workshop",Cat="Workshops",Date="5 Jul 2024",Count="32",Img="photo-1516321318423-f06f85e504b3"},new {Title="Career Guidance Session",Cat="Talks",Date="20 Nov 2024",Count="18",Img="photo-1523580494863-6f3031224c94"},new {Title="Community Meet",Cat="Community",Date="12 Apr 2024",Count="30",Img="photo-1529156069898-49953e39b3ac"},new {Title="Annual Tech Fest",Cat="Events",Date="28 Mar 2024",Count="50",Img="photo-1540575467063-178a50c2df87"}
}; }
<div class="gallery-layout"><div class="gallery-grid" id="galleryGrid">@foreach (var g in gallery) { <article class="gallery-card" data-category="@g.Cat" data-title="@g.Title" data-date="@DateTime.Parse(g.Date).ToString("yyyy-MM-dd")"><div class="gallery-photo"><img src="https://images.unsplash.com/@(g.Img)?auto=format&fit=crop&w=1000&q=80" alt="@g.Title"/><span class="photo-count">▧ @g.Count</span></div><div class="gallery-info"><div><span class="tag">@g.Cat</span><small>▦ @g.Date</small></div><h3>@g.Title</h3><button aria-label="Open @g.Title">→</button></div></article> }</div>
<aside class="reels-rail"><a class="reel-card" href="#" aria-label="Highlights from Web Development Workshop"><img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=700&q=85" alt="Web development workshop highlights"/><span class="reel-label">▣ Reels</span><span class="reel-play">▶</span><small>0:45</small><strong>Highlights from<br/>Web Development Workshop ✨</strong><b class="reel-arrow">→</b></a><a class="reel-card" href="#" aria-label="ACM Cultural Night highlights"><img src="https://images.unsplash.com/photo-1501386761578-eac5c94b800a?auto=format&fit=crop&w=700&q=85" alt="ACM cultural night"/><span class="reel-label">▣ Reels</span><span class="reel-play">▶</span><small>0:32</small><strong>ACM Cultural Night Highlights 💜</strong><b class="reel-arrow">→</b></a></aside></div>
</section><script src="~/js/showcase.js" asp-append-version="true"></script>
