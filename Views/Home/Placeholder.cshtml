@{
    ViewData["Title"] = ViewBag.PageTitle ?? "Coming Soon";
}

<div class="container" style="max-width: 800px; margin: 4rem auto; text-align: center; padding: 3rem 1.5rem; background: var(--card-bg, #ffffff); border-radius: 1rem; border: 1px solid var(--border-color, #e5e7eb); box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);">
    <div style="width: 72px; height: 72px; background: rgba(147, 51, 234, 0.1); color: #9333ea; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto;">
        <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
    </div>
    <h1 style="font-size: 2.25rem; font-weight: 800; color: #111827; margin-bottom: 0.75rem;">
        @(ViewBag.PageTitle ?? "Coming Soon")
    </h1>
    <p style="font-size: 1.125rem; color: #6b7280; max-width: 540px; margin: 0 auto 2rem auto; line-height: 1.6;">
        This section is currently under development and will be updated soon. Stay tuned for exciting updates from ACM AMTICS!
    </p>
    <a href="/" class="btn-primary-purple" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; text-decoration: none; border-radius: 9999px; background: linear-gradient(135deg, #9333ea, #7e22ce); color: #ffffff; font-weight: 600;">
        <span>Return to Home</span>
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
    </a>
</div>
