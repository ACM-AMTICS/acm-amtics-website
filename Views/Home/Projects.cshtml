@model acm_amtics_website.Models.ProjectsViewModel
@{ ViewData["Title"] = "Student Projects"; }
<link rel="stylesheet" href="~/css/showcase.css" asp-append-version="true" />
<section class="showcase-page">
<div class="showcase-hero project-hero"><div><div class="crumb"><a href="/">⌂ Home</a><span>›</span> Projects</div><h1>Student <em>Projects</em></h1><p>Explore innovative projects built by our members. From open source contributions to real-world solutions, these projects showcase the creativity and technical skills of the AMTICS community.</p></div><div class="hero-art project-art"><span>▱</span><small>Build<br/>Innovate<br/>Collaborate<br/>Create Impact</small></div></div>
<div class="filter-panel project-filters"><label class="search-field">⌕ <input id="projectSearch" placeholder="Search projects by name, technology or keyword..." /></label><select id="categoryFilter">@foreach (var c in Model.Categories) { <option value="@(c.StartsWith("All") ? "" : c)">@c</option> }</select><select id="techFilter">@foreach (var t in Model.Technologies) { <option value="@(t.StartsWith("All") ? "" : t)">@t</option> }</select><select id="yearFilter">@foreach (var y in Model.Years) { <option value="@(y.StartsWith("All") ? "" : y)">@y</option> }</select><select id="projectSort"><option value="recent">Most Recent</option><option value="az">Name A–Z</option></select></div>
<h2 class="list-heading">All Projects <span>(@Model.Items.Count)</span></h2><p class="list-subtitle">A collection of member-built projects, open source contributions and innovative solutions.</p>
<div class="project-grid" id="projectGrid">@foreach (var p in Model.Items) {
    var imgSrc = !string.IsNullOrEmpty(p.Image) && (p.Image.StartsWith("http") || p.Image.StartsWith("/"))
        ? p.Image
        : (!string.IsNullOrEmpty(p.Image) ? $"https://images.unsplash.com/{p.Image}?auto=format&fit=crop&w=900&q=80" : "/images/projects/campus-connect.jpg");
    <article class="project-card" data-name="@p.Name" data-cat="@p.Category" data-tech="@p.Tech" data-year="@p.Year"><img src="@imgSrc" alt="@p.Name project"/><div class="project-card-body"><div class="tag-row"><span class="tag">@p.Category</span><span class="tag green">@p.Tag</span></div><h3>@p.Name</h3><p>@p.Description</p><div class="tech-row">@p.Tech</div><div class="project-meta"><span>👥 @p.Team</span><span>▦ @p.Year</span></div><a href="@(!string.IsNullOrWhiteSpace(p.GithubUrl) ? p.GithubUrl : "#")" target="_blank" rel="noopener noreferrer" class="project-link">View Project <b>→</b></a></div></article>
}</div>
</section><script src="~/js/showcase.js" asp-append-version="true"></script>
