@{ ViewData["Title"] = "Student Projects"; }
<link rel="stylesheet" href="~/css/showcase.css" asp-append-version="true" />
<section class="showcase-page">
<div class="showcase-hero project-hero"><div><div class="crumb"><a href="/">⌂ Home</a><span>›</span> Projects</div><h1>Student <em>Projects</em></h1><p>Explore innovative projects built by our members. From open source contributions to real-world solutions, these projects showcase the creativity and technical skills of the AMTICS community.</p></div><div class="hero-art project-art"><span>▱</span><small>Build<br/>Innovate<br/>Collaborate<br/>Create Impact</small></div></div>
<div class="filter-panel project-filters"><label class="search-field">⌕ <input id="projectSearch" placeholder="Search projects by name, technology or keyword..." /></label><select id="categoryFilter"><option value="">All Categories</option><option>Web App</option><option>AI/ML</option><option>Mobile App</option><option>Developer Tool</option><option>Cybersecurity</option></select><select id="techFilter"><option value="">All Technologies</option><option>React</option><option>Python</option><option>Flutter</option><option>Next.js</option></select><select id="yearFilter"><option value="">All Years</option><option>2025</option><option>2024</option><option>2023</option></select><select id="projectSort"><option value="recent">Most Recent</option><option value="az">Name A–Z</option></select></div>
<h2 class="list-heading">All Projects <span>(24)</span></h2><p class="list-subtitle">A collection of member-built projects, open source contributions and innovative solutions.</p>
@{ var projects = new[] {
new {Name="EcoTrack",Cat="Web App",Tag="Sustainability",Tech="React · Node.js · MongoDB",Year="2025",Team="Team GreenCode",Desc="A web platform to help students track their carbon footprint and take actionable steps towards a greener campus.",Img="photo-1473341304170-971dccb5ac1e"},
new {Name="LearnMate",Cat="AI/ML",Tag="Education",Tech="Python · TensorFlow · FastAPI",Year="2024",Team="Team ByteBuddies",Desc="An AI-powered study assistant that summarizes notes, generates quizzes and helps with exam preparation.",Img="photo-1677442136019-21780ecad995"},
new {Name="AMTICS Navigator",Cat="Mobile App",Tag="Campus Utility",Tech="Flutter · Firebase · Maps API",Year="2024",Team="Team Trailblazers",Desc="A mobile app to help students navigate the AMTICS campus with indoor maps, event updates and important resources.",Img="photo-1524666041070-9fcf9fb4b7e1"},
new {Name="ShieldNet",Cat="Cybersecurity",Tag="Open Source",Tech="Python · Scapy · Docker",Year="2024",Team="Team SecureBits",Desc="An open source network monitoring tool to detect suspicious activity and enhance campus network security.",Img="photo-1550751827-4bd374c3f58b"},
new {Name="MindSpace",Cat="Web App",Tag="Health & Wellness",Tech="React · Node.js · PostgreSQL",Year="2023",Team="Team MindMates",Desc="A safe and anonymous platform for students to track their mood, access resources and connect with support communities.",Img="photo-1517841905240-472988babdf9"},
new {Name="CodeCollab",Cat="Developer Tool",Tag="Productivity",Tech="Next.js · WebSockets · MongoDB",Year="2023",Team="Team DevSync",Desc="A real-time collaborative code editor built for student teams with integrated chat and version control.",Img="photo-1518770660439-4636190af475"},
new {Name="DisasterRelief AI",Cat="AI/ML",Tag="Social Impact",Tech="Python · OpenCV · TensorFlow",Year="2023",Team="Team Impact",Desc="An AI-based system to analyze satellite images and identify disaster-affected areas for faster response.",Img="photo-1519608487953-e999c86e7455"},
new {Name="EventHub",Cat="Web App",Tag="Community",Tech="React · Firebase · Tailwind CSS",Year="2023",Team="Team Eventify",Desc="A central platform to discover, register and manage all ACM AMTICS events and workshops.",Img="photo-1517248135467-4c7edcad34c4"}
}; }
<div class="project-grid" id="projectGrid">@foreach (var p in projects) { <article class="project-card" data-name="@p.Name" data-cat="@p.Cat" data-tech="@p.Tech" data-year="@p.Year"><img src="https://images.unsplash.com/@(p.Img)?auto=format&fit=crop&w=900&q=80" alt="@p.Name project"/><div class="project-card-body"><div class="tag-row"><span class="tag">@p.Cat</span><span class="tag green">@p.Tag</span></div><h3>@p.Name</h3><p>@p.Desc</p><div class="tech-row">@p.Tech</div><div class="project-meta"><span>👥 @p.Team</span><span>▦ @p.Year</span></div><a href="#" class="project-link">View Project <b>→</b></a></div></article> }</div>
</section><script src="~/js/showcase.js" asp-append-version="true"></script>
