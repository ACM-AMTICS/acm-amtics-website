@{ ViewData["Title"] = "Our Team"; }
<link rel="stylesheet" href="~/css/showcase.css" asp-append-version="true" />
<section class="showcase-page team-page">
<div class="showcase-hero team-hero"><div><div class="crumb"><a href="/">⌂ Home</a><span>›</span> Team</div><h1>Our <em>Team</em></h1><h2>The People Behind ACM AMTICS</h2><p>A passionate group of students, leaders, and contributors working together to build a vibrant tech community at AMTICS. Meet the people who make ideas happen.</p><div class="value-pills"><span>♧ Ideas to Solutions</span><span>♧ People & Community</span><span>⌘ Technology for Impact</span></div></div><div class="hero-art team-art"><span>acm</span><small>Ideas · People<br/>Technology · Community<br/>Learn · Collaborate · Create</small></div></div>
@{ var heads = new[] {new {Name="Ayesha Khan",Role="Chairperson",Year="3rd Year · CSE",Desc="Leading the vision and growth of ACM AMTICS.",Img="photo-1534528741775-53994a69daeb"},new {Name="Rohan Mehta",Role="Vice Chairperson",Year="3rd Year · CSE",Desc="Supporting initiatives and strengthening the community.",Img="photo-1500648767791-00dcc994a43e"},new {Name="Zara Sheikh",Role="Secretary",Year="3rd Year · IT",Desc="Managing operations and ensuring smooth coordination.",Img="photo-1531123897727-8f129e1688ce"},new {Name="Arman Siddiqui",Role="Joint Secretary",Year="2nd Year · CSE",Desc="Assisting in planning and execution of events.",Img="photo-1506794778202-cad84cf45f1d"},new {Name="Sana Khan",Role="Treasurer",Year="3rd Year · AI&DS",Desc="Handling finances and resource management.",Img="photo-1544005313-94ddf0286df2"}}; }
