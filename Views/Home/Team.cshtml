@{ var contributors = new[] {new {Name="Mohammed Ali",Year="3rd Year · CSE",Desc="Contributed to events, content and community initiatives.",Img="photo-1506794778202-cad84cf45f1d"},new {Name="Riya Sharma",Year="3rd Year · CSE",Desc="Design and social media contributions.",Img="photo-1534528741775-53994a69daeb"},new {Name="Devansh Jain",Year="2nd Year · CSE",Desc="Supported events and technical initiatives.",Img="photo-1500648767791-00dcc994a43e"},new {Name="Kriti Singh",Year="3rd Year · IT",Desc="Helped in content creation and event management.",Img="photo-1531123897727-8f129e1688ce"}}; }
